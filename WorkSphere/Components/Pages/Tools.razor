@page "/tools"
@using WorkSphere.Services
@using WorkSphere.Models
@using System.Text
@using System.IO
@inject IRestoreService RestoreService
@inject IWorkLogService WorkLogService
@inject IExportService ExportService
@inject BackupSchedulerState SchedulerState
@inject IConfiguration Configuration
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<div class="mb-4">
    <MudText Typo="Typo.h4">System Tools & Backups</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">
        Manage server snapshots, database restore points, customized data exports, and automation schedules.
    </MudText>
</div>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Primary" KeepPanelsAlive="true">
    <!-- Tab 1: Backups & Snapshots -->
    <MudTabPanel Text="Backups & Snapshots" Icon="@Icons.Material.Filled.Storage" Class="pa-4">
        <MudStack Spacing="4">
            <!-- Header Action & Scheduler Summary Card -->
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-3">
                        <div>
                            <MudText Typo="Typo.h6">Server Snapshots</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Snapshots contain a complete JSON database dump, CSV logs, and monthly Markdown notes stored in <code>@_defaultExportDir</code>.
                            </MudText>
                        </div>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Backup"
                                   OnClick="TriggerServerBackupAsync"
                                   Disabled="@_isExporting">
                            @(_isExporting ? "Creating Backup..." : "Create Server Backup Now")
                        </MudButton>
                    </MudStack>

                    <MudDivider Class="my-3" />

                    <!-- Scheduler Status Bar -->
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-wrap gap-4">
                        <div class="d-flex align-center">
                            <MudText Typo="Typo.caption" Class="me-2 text-muted">Scheduler:</MudText>
                            <MudChip T="string" Color="@(SchedulerState.IsEnabled ? Color.Success : Color.Default)" Size="Size.Small" Variant="Variant.Filled">
                                @(SchedulerState.IsEnabled ? $"Active ({SchedulerState.CronExpression})" : "Disabled")
                            </MudChip>
                        </div>

                        <div class="d-flex align-center">
                            <MudText Typo="Typo.caption" Class="me-2 text-muted">Retention:</MudText>
                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                                @(_maxBackupHistory.HasValue && _maxBackupHistory.Value > 0 ? $"Keep last {_maxBackupHistory.Value} backups" : "Unlimited history")
                            </MudChip>
                        </div>

                        @if (SchedulerState.NextRunUtc.HasValue)
                        {
                            <div class="d-flex align-center">
                                <MudText Typo="Typo.caption" Class="me-1 text-muted">Next Run:</MudText>
                                <MudText Typo="Typo.body2">@SchedulerState.NextRunUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC</MudText>
                            </div>
                        }

                        @if (SchedulerState.LastRunUtc.HasValue)
                        {
                            <div class="d-flex align-center">
                                <MudText Typo="Typo.caption" Class="me-1 text-muted">Last Run:</MudText>
                                <MudText Typo="Typo.body2">
                                    @SchedulerState.LastRunUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC
                                    @(SchedulerState.LastRunSuccess == true ? " (Success)" : " (Failed)")
                                </MudText>
                            </div>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>

            <!-- Feedback Alert for Snapshot Restore -->
            @if (_lastRestoreResult != null && _lastRestoreSource == "Snapshot")
            {
                <MudAlert Severity="@(_lastRestoreResult.Success ? Severity.Success : Severity.Error)" Variant="Variant.Outlined" Dense="true" ShowCloseIcon="true" CloseIconClicked="() => _lastRestoreResult = null">
                    @if (_lastRestoreResult.Success)
                    {
                        <div>
                            <strong>Snapshot Restore Completed Successfully:</strong>
                            Restored @_lastRestoreResult.WorkLogsRestored work logs (Skipped @_lastRestoreResult.WorkLogsSkipped duplicates).
                            Employees added: @_lastRestoreResult.EmployeesRestored | Incidents added: @_lastRestoreResult.IncidentsRestored.
                        </div>
                    }
                    else
                    {
                        <div><strong>Restore Failed:</strong> @_lastRestoreResult.ErrorMessage</div>
                    }
                </MudAlert>
            }

            @if (_isRestoring)
            {
                <MudPaper Elevation="0" Class="pa-3 d-flex align-center justify-center mud-background-gray rounded">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" Class="me-3" />
                    <MudText Typo="Typo.body2">Restoring database snapshot records, please wait...</MudText>
                </MudPaper>
            }

            <!-- Server Snapshots Table -->
            <MudTable Items="@_serverSnapshots"
                      Dense="true"
                      Hover="true"
                      Elevation="1"
                      Breakpoint="Breakpoint.Sm"
                      Loading="@_isRestoring">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Available Server Snapshots (@_serverSnapshots.Count)</MudText>
                    <MudSpacer />
                    <MudTooltip Text="Refresh snapshot list">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" OnClick="RefreshSnapshots" aria-label="Refresh snapshot list" />
                    </MudTooltip>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Snapshot Directory</MudTh>
                    <MudTh>Timestamp (UTC)</MudTh>
                    <MudTh>Included Backups</MudTh>
                    <MudTh>Total Size</MudTh>
                    <MudTh Style="text-align: right;">Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Snapshot Directory">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.FolderZip" Color="Color.Primary" Size="Size.Small" Class="me-2" />
                            <strong>@context.DirectoryName</strong>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Timestamp (UTC)">
                        @(context.TimestampUtc.HasValue ? context.TimestampUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") : "-")
                    </MudTd>
                    <MudTd DataLabel="Included Backups">
                        <MudStack Row="true" Spacing="1">
                            @if (context.HasJsonBackup)
                            {
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Text">JSON DB</MudChip>
                            }
                            @if (context.HasCsvBackup)
                            {
                                <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Text">CSV Logs</MudChip>
                            }
                            @if (context.MarkdownFileCount > 0)
                            {
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text">@context.MarkdownFileCount Notes</MudChip>
                            }
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Total Size">
                        @FormatBytes(context.TotalSizeBytes)
                    </MudTd>
                    <MudTd DataLabel="Action" Style="text-align: right;">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.SettingsBackupRestore"
                                   OnClick="@(() => RestoreSnapshotWithConfirmationAsync(context))"
                                   Disabled="@(_isRestoring || (!context.HasJsonBackup && !context.HasCsvBackup))">
                            Restore
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="my-2">
                        No snapshots found in <code>@_defaultExportDir</code>. Click <strong>Create Server Backup Now</strong> above to generate your first snapshot.
                    </MudAlert>
                </NoRecordsContent>
            </MudTable>
        </MudStack>
    </MudTabPanel>

    <!-- Tab 2: Custom Data Export -->
    <MudTabPanel Text="Custom Data Export" Icon="@Icons.Material.Filled.Download" Class="pa-4">
        <MudCard Elevation="1">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Data Export Hub</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Configure filters and download customized work logs, comp time reports, or incident data directly to your device.
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid Spacing="3">
                    <!-- Target & Format -->
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" Label="Export Data Target" Value="@_exportTarget" ValueChanged="OnExportTargetChanged" Variant="Variant.Outlined" Dense="true">
                            <MudSelectItem Value="@("WorkLogs")">Work Logs (Activity Records)</MudSelectItem>
                            <MudSelectItem Value="@("CompTime")">Comp Time Balances & Summary</MudSelectItem>
                            <MudSelectItem Value="@("Incidents")">Incidents & Outages</MudSelectItem>
                            <MudSelectItem Value="@("FullBackup")">Complete System Backup (JSON Snapshot)</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" Label="File Format" @bind-Value="_exportFormat" Variant="Variant.Outlined" Dense="true" Disabled="@(_exportTarget == "CompTime" || _exportTarget == "Incidents" || _exportTarget == "FullBackup")">
                            @if (_exportTarget == "WorkLogs")
                            {
                                <MudSelectItem Value="@("CSV")">CSV (.csv)</MudSelectItem>
                                <MudSelectItem Value="@("MarkdownExtended")">Markdown (Extended format)</MudSelectItem>
                                <MudSelectItem Value="@("MarkdownOriginal")">Markdown (Original format)</MudSelectItem>
                            }
                            else if (_exportTarget == "FullBackup")
                            {
                                <MudSelectItem Value="@("JSON")">JSON (.json)</MudSelectItem>
                            }
                            else
                            {
                                <MudSelectItem Value="@("CSV")">CSV (.csv)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <!-- WorkLogs CSV Options -->
                    @if (_exportTarget == "WorkLogs" && _exportFormat == "CSV")
                    {
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" Label="Date Range Preset" Value="@_selectedRangePreset" ValueChanged="OnRangePresetChanged" Variant="Variant.Outlined" Dense="true">
                                <MudSelectItem Value="@("All Time")">All Time</MudSelectItem>
                                <MudSelectItem Value="@("This Month")">This Month</MudSelectItem>
                                <MudSelectItem Value="@("Last Month")">Last Month</MudSelectItem>
                                <MudSelectItem Value="@("Last 30 Days")">Last 30 Days</MudSelectItem>
                                <MudSelectItem Value="@("Last 3 Months")">Last 3 Months</MudSelectItem>
                                <MudSelectItem Value="@("Last 6 Months")">Last 6 Months</MudSelectItem>
                                <MudSelectItem Value="@("This Year")">This Year</MudSelectItem>
                                <MudSelectItem Value="@("Custom Range")">Custom Range</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        @if (_selectedRangePreset == "Custom Range")
                        {
                            <MudItem xs="12" sm="6">
                                <MudDateRangePicker Label="Custom Date Range" @bind-DateRange="_customDateRange" Variant="Variant.Outlined" />
                            </MudItem>
                        }

                        <MudItem xs="12" sm="6">
                            <MudSelect T="int?" Label="Employee Filter" @bind-Value="_selectedEmployeeId" Clearable="true" Variant="Variant.Outlined" Dense="true">
                                <MudSelectItem T="int?" Value="@((int?)null)">All Employees</MudSelectItem>
                                @foreach (var emp in _employees)
                                {
                                    <MudSelectItem T="int?" Value="@emp.Id">@emp.Name (@emp.Initials)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6" Class="d-flex align-center">
                            <MudCheckBox T="bool" @bind-Value="_compTimeOnly" Label="Filter Comp Time logs only" Color="Color.Primary" Dense="true" />
                        </MudItem>
                    }
                    else if (_exportTarget == "WorkLogs" && (_exportFormat == "MarkdownOriginal" || _exportFormat == "MarkdownExtended"))
                    {
                        <MudItem xs="12" sm="4">
                            <MudSelect T="int" Label="Year" @bind-Value="_exportYear" Variant="Variant.Outlined" Dense="true">
                                @foreach (var y in Enumerable.Range(2024, DateTime.Today.Year - 2024 + 2))
                                {
                                    <MudSelectItem Value="@y" />
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudSelect T="int" Label="Month" @bind-Value="_exportMonth" Variant="Variant.Outlined" Dense="true">
                                <MudSelectItem Value="1">January</MudSelectItem>
                                <MudSelectItem Value="2">February</MudSelectItem>
                                <MudSelectItem Value="3">March</MudSelectItem>
                                <MudSelectItem Value="4">April</MudSelectItem>
                                <MudSelectItem Value="5">May</MudSelectItem>
                                <MudSelectItem Value="6">June</MudSelectItem>
                                <MudSelectItem Value="7">July</MudSelectItem>
                                <MudSelectItem Value="8">August</MudSelectItem>
                                <MudSelectItem Value="9">September</MudSelectItem>
                                <MudSelectItem Value="10">October</MudSelectItem>
                                <MudSelectItem Value="11">November</MudSelectItem>
                                <MudSelectItem Value="12">December</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudSelect T="int?" Label="Employee Filter" @bind-Value="_selectedEmployeeId" Clearable="true" Variant="Variant.Outlined" Dense="true">
                                <MudSelectItem T="int?" Value="@((int?)null)">All Employees</MudSelectItem>
                                @foreach (var emp in _employees)
                                {
                                    <MudSelectItem T="int?" Value="@emp.Id">@emp.Name (@emp.Initials)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                    else if (_exportTarget == "CompTime")
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                Exports a comprehensive CSV report containing each employee's comp time earned, used, and remaining balance.
                            </MudAlert>
                        </MudItem>
                    }
                    else if (_exportTarget == "Incidents")
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                Exports an incident registry CSV including ticket numbers, titles, outage durations, and closure statuses.
                            </MudAlert>
                        </MudItem>
                    }
                    else if (_exportTarget == "FullBackup")
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                Exports a standalone JSON snapshot containing all employee records, incidents, and complete work log history.
                            </MudAlert>
                        </MudItem>
                    }
                </MudGrid>
            </MudCardContent>
            <MudCardActions Class="pa-4 d-flex align-center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="DownloadExportAsync"
                           Disabled="@_isExporting"
                           StartIcon="@Icons.Material.Filled.Download">
                    @(_isExporting ? "Generating Export..." : "Download Export to Device")
                </MudButton>

                @if (_isExporting)
                {
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" Class="ms-3" />
                }
            </MudCardActions>
        </MudCard>
    </MudTabPanel>

    <!-- Tab 3: File Import & Restore -->
    <MudTabPanel Text="File Import & Restore" Icon="@Icons.Material.Filled.UploadFile" Class="pa-4">
        <MudGrid>
            <MudItem xs="12" md="8" lg="6">
                <MudCard Elevation="1">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Import & Restore File</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Upload a full system JSON snapshot or an RFC 4180 CSV export.
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudStack Spacing="3">
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                <strong>Smart Import:</strong> Duplicate records are automatically skipped. Missing employees and incidents referenced in the file will be automatically created.
                            </MudAlert>

                            <MudFileUpload T="IBrowserFile" FilesChanged="OnUploadFileSelected" Accept=".json,.csv">
                                <CustomContent>
                                    <MudButton HtmlTag="label"
                                               Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.CloudUpload"
                                               for="@context.FieldId">
                                        Choose .json or .csv File
                                    </MudButton>
                                </CustomContent>
                            </MudFileUpload>

                            @if (_uploadedFile != null)
                            {
                                <MudPaper Elevation="0" Class="pa-3 mud-background-gray rounded d-flex align-center justify-space-between">
                                    <div>
                                        <div class="d-flex align-center">
                                            <MudIcon Icon="@(_uploadedFile.Name.EndsWith(".json", StringComparison.OrdinalIgnoreCase) ? Icons.Material.Filled.DataObject : Icons.Material.Filled.TableChart)"
                                                     Color="Color.Primary"
                                                     Class="me-2" />
                                            <strong>@_uploadedFile.Name</strong>
                                        </div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Size: @(Math.Round(_uploadedFile.Size / 1024.0, 1)) KB
                                        </MudText>
                                    </div>
                                    <MudTooltip Text="Remove file">
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="ClearUploadedFile" aria-label="Remove file" />
                                    </MudTooltip>
                                </MudPaper>

                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           OnClick="RestoreUploadedFileAsync"
                                           Disabled="@_isRestoring"
                                           StartIcon="@Icons.Material.Filled.FileDownload">
                                    @(_isRestoring ? "Importing..." : "Import & Restore Selected File")
                                </MudButton>
                            }

                            @if (_isRestoring)
                            {
                                <div class="d-flex align-center mt-2">
                                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" Class="me-2" />
                                    <MudText Typo="Typo.caption">Processing and validating records...</MudText>
                                </div>
                            }

                            @if (_lastRestoreResult != null && _lastRestoreSource == "File")
                            {
                                <MudAlert Severity="@(_lastRestoreResult.Success ? Severity.Success : Severity.Error)" Variant="Variant.Outlined" Dense="true" ShowCloseIcon="true" CloseIconClicked="() => _lastRestoreResult = null">
                                    @if (_lastRestoreResult.Success)
                                    {
                                        <div>
                                            <strong>File Import Completed:</strong>
                                            <br />
                                            Work logs restored: @_lastRestoreResult.WorkLogsRestored (Skipped @_lastRestoreResult.WorkLogsSkipped duplicates)
                                            <br />
                                            Employees created: @_lastRestoreResult.EmployeesRestored | Incidents created: @_lastRestoreResult.IncidentsRestored
                                        </div>
                                    }
                                    else
                                    {
                                        <div><strong>Import Failed:</strong> @_lastRestoreResult.ErrorMessage</div>
                                    }
                                </MudAlert>
                            }
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <!-- Tab 4: Automation & Scheduling -->
    <MudTabPanel Text="Automation & Scheduling" Icon="@Icons.Material.Filled.Schedule" Class="pa-4">
        <MudGrid Spacing="3">
            <!-- Left Column: Scheduler & CLI -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="1" Class="h-100">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">In-Process Scheduler & Configuration</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudChip T="string" Color="@(SchedulerState.IsEnabled ? Color.Success : Color.Default)" Size="Size.Small">
                                @(SchedulerState.IsEnabled ? "Enabled" : "Disabled")
                            </MudChip>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudStack Spacing="3">
                            <MudSimpleTable Dense="true" Hover="true">
                                <thead>
                                    <tr>
                                        <th>Setting</th>
                                        <th>Config Source</th>
                                        <th>Resolved Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Scheduler Status</td>
                                        <td><code>Export:ScheduledBackup:Enabled</code></td>
                                        <td>@(SchedulerState.IsEnabled ? "Active" : "Disabled")</td>
                                    </tr>
                                    <tr>
                                        <td>Cron Schedule</td>
                                        <td><code>Export:ScheduledBackup:CronSchedule</code></td>
                                        <td><code>@SchedulerState.CronExpression</code></td>
                                    </tr>
                                    <tr>
                                        <td>Storage Directory</td>
                                        <td><code>Export:OutputPath</code> or <code>EXPORT_PATH</code></td>
                                        <td><code>@_defaultExportDir</code></td>
                                    </tr>
                                    <tr>
                                        <td>Snapshot Retention</td>
                                        <td><code>Export:ScheduledBackup:MaxBackupHistory</code></td>
                                        <td>@(_maxBackupHistory.HasValue && _maxBackupHistory.Value > 0 ? $"Keep last {_maxBackupHistory.Value} snapshots" : "Unlimited (Never delete)")</td>
                                    </tr>
                                </tbody>
                            </MudSimpleTable>

                            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mt-2">Headless CLI Command</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                WorkSphere can be executed headlessly for Cron jobs or ad-hoc volume backups:
                            </MudText>
                            <pre class="pa-3 rounded" style="font-family: monospace; font-size: 0.85rem; overflow-x: auto; background-color: var(--mud-palette-background-grey);">dotnet WorkSphere.dll --backup</pre>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Override destination output directory:</MudText>
                            <pre class="pa-2 rounded" style="font-family: monospace; font-size: 0.82rem; overflow-x: auto; background-color: var(--mud-palette-background-grey);">dotnet WorkSphere.dll --backup --output /mnt/backups</pre>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Right Column: Kubernetes Manifest -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="1" Class="h-100">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Kubernetes CronJob Manifest</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Example manifest for running nightly automated backups with persistent storage.
                            </MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIcon Icon="@Icons.Custom.Brands.GitHub" Color="Color.Default" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <pre class="pa-3 rounded" style="font-family: monospace; font-size: 0.78rem; overflow-x: auto; max-height: 380px; background-color: var(--mud-palette-background-grey);">apiVersion: batch/v1
kind: CronJob
metadata:
  name: worksphere-nightly-backup
spec:
  schedule: "0 2 * * *" # Run nightly at 2:00 AM
  jobTemplate:
    spec:
      template:
        spec:
          containers:
          - name: backup
            image: worksphere:latest
            args: ["--backup"]
            env:
            - name: ConnectionStrings__DefaultConnection
              valueFrom:
                secretKeyRef:
                  name: worksphere-secrets
                  key: db-connection
            - name: EXPORT_PATH
              value: "/backups"
            volumeMounts:
            - name: backup-storage
              mountPath: /backups
          restartPolicy: OnFailure
          volumes:
          - name: backup-storage
            persistentVolumeClaim:
              claimName: worksphere-backup-pvc</pre>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudTabPanel>
</MudTabs>

@code {
    private bool _isRestoring = false;
    private bool _isExporting = false;

    private List<ServerSnapshotInfo> _serverSnapshots = [];
    private IBrowserFile? _uploadedFile;
    private RestoreResult? _lastRestoreResult;
    private string? _lastRestoreSource; // "Snapshot" or "File"

    private string _exportTarget = "WorkLogs";
    private string _exportFormat = "CSV";
    private int _exportYear = DateTime.Today.Year;
    private int _exportMonth = DateTime.Today.Month;

    private string _selectedRangePreset = "All Time";
    private DateRange? _customDateRange;
    private DateOnly? _filterStartDate;
    private DateOnly? _filterEndDate;
    private int? _selectedEmployeeId;
    private bool _compTimeOnly;

    private List<Employee> _employees = [];
    private string _defaultExportDir = "Exports";
    private int? _maxBackupHistory;

    protected override async Task OnInitializedAsync()
    {
        _employees = (await WorkLogService.GetEmployeesAsync()).ToList();
        _defaultExportDir = ExportService.GetDefaultExportDirectory();
        _maxBackupHistory = Configuration.GetValue<int?>("Export:ScheduledBackup:MaxBackupHistory");
        RefreshSnapshots();
    }

    private void RefreshSnapshots()
    {
        _serverSnapshots = RestoreService.GetAvailableServerSnapshots();
    }

    private async Task RestoreSnapshotWithConfirmationAsync(ServerSnapshotInfo snapshot)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirm Snapshot Restore",
            $"Are you sure you want to restore from snapshot '{snapshot.DirectoryName}'? Existing database records will not be deleted, and missing records will be restored.",
            yesText: "Restore Snapshot",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            _isRestoring = true;
            _lastRestoreResult = null;
            _lastRestoreSource = "Snapshot";
            try
            {
                var result = await RestoreService.RestoreFromSnapshotDirectoryAsync(snapshot.FullPath);
                _lastRestoreResult = result;
                if (result.Success)
                {
                    Snackbar.Add($"Restored snapshot: {result.WorkLogsRestored} logs restored ({result.WorkLogsSkipped} duplicates skipped).", Severity.Success);
                    _employees = (await WorkLogService.GetEmployeesAsync()).ToList();
                }
                else
                {
                    Snackbar.Add($"Snapshot restore failed: {result.ErrorMessage}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                _lastRestoreResult = RestoreResult.Failed(ex.Message);
                Snackbar.Add($"Snapshot restore failed: {ex.Message}", Severity.Error);
            }
            finally
            {
                _isRestoring = false;
            }
        }
    }

    private void OnUploadFileSelected(IBrowserFile file)
    {
        _uploadedFile = file;
        _lastRestoreResult = null;
    }

    private void ClearUploadedFile()
    {
        _uploadedFile = null;
        _lastRestoreResult = null;
    }

    private async Task RestoreUploadedFileAsync()
    {
        if (_uploadedFile == null) return;
        _isRestoring = true;
        _lastRestoreResult = null;
        _lastRestoreSource = "File";
        try
        {
            using var stream = _uploadedFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var reader = new StreamReader(stream, Encoding.UTF8);
            var content = await reader.ReadToEndAsync();

            var ext = Path.GetExtension(_uploadedFile.Name).ToLowerInvariant();
            if (ext == ".json")
            {
                _lastRestoreResult = await RestoreService.RestoreFromJsonAsync(content);
            }
            else if (ext == ".csv")
            {
                _lastRestoreResult = await RestoreService.ImportWorkLogsFromCsvAsync(content);
            }
            else
            {
                _lastRestoreResult = RestoreResult.Failed($"Unsupported file format '{ext}'. Please upload a .json or .csv file.");
            }

            if (_lastRestoreResult.Success)
            {
                Snackbar.Add($"Imported successfully: {_lastRestoreResult.WorkLogsRestored} logs restored ({_lastRestoreResult.WorkLogsSkipped} duplicates skipped).", Severity.Success);
                _employees = (await WorkLogService.GetEmployeesAsync()).ToList();
                RefreshSnapshots();
            }
            else
            {
                Snackbar.Add($"Import failed: {_lastRestoreResult.ErrorMessage}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _lastRestoreResult = RestoreResult.Failed(ex.Message);
            Snackbar.Add($"File restore failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isRestoring = false;
        }
    }

    private void OnExportTargetChanged(string target)
    {
        _exportTarget = target;
        _exportFormat = target switch
        {
            "WorkLogs" => "CSV",
            "CompTime" => "CSV",
            "Incidents" => "CSV",
            "FullBackup" => "JSON",
            _ => "CSV"
        };
    }

    private void OnRangePresetChanged(string preset)
    {
        _selectedRangePreset = preset;
        var today = DateOnly.FromDateTime(DateTime.Today);

        switch (preset)
        {
            case "This Month":
                _filterStartDate = new DateOnly(today.Year, today.Month, 1);
                _filterEndDate = _filterStartDate.Value.AddMonths(1).AddDays(-1);
                break;
            case "Last Month":
                var firstOfThisMonth = new DateOnly(today.Year, today.Month, 1);
                _filterStartDate = firstOfThisMonth.AddMonths(-1);
                _filterEndDate = firstOfThisMonth.AddDays(-1);
                break;
            case "Last 30 Days":
                _filterStartDate = today.AddDays(-30);
                _filterEndDate = today;
                break;
            case "Last 3 Months":
                _filterStartDate = today.AddMonths(-3);
                _filterEndDate = today;
                break;
            case "Last 6 Months":
                _filterStartDate = today.AddMonths(-6);
                _filterEndDate = today;
                break;
            case "This Year":
                _filterStartDate = new DateOnly(today.Year, 1, 1);
                _filterEndDate = new DateOnly(today.Year, 12, 31);
                break;
            case "Custom Range":
                if (_customDateRange?.Start != null && _customDateRange?.End != null)
                {
                    _filterStartDate = DateOnly.FromDateTime(_customDateRange.Start.Value);
                    _filterEndDate = DateOnly.FromDateTime(_customDateRange.End.Value);
                }
                break;
            case "All Time":
            default:
                _filterStartDate = null;
                _filterEndDate = null;
                break;
        }
    }

    private async Task DownloadExportAsync()
    {
        _isExporting = true;
        try
        {
            switch (_exportTarget)
            {
                case "WorkLogs":
                    if (_exportFormat == "CSV")
                    {
                        var start = _filterStartDate;
                        var end = _filterEndDate;
                        if (_selectedRangePreset == "Custom Range" && _customDateRange?.Start != null && _customDateRange?.End != null)
                        {
                            start = DateOnly.FromDateTime(_customDateRange.Start.Value);
                            end = DateOnly.FromDateTime(_customDateRange.End.Value);
                        }

                        var filter = new WorkLogExportFilter
                        {
                            StartDate = start,
                            EndDate = end,
                            EmployeeId = _selectedEmployeeId,
                            CompTimeOnly = _compTimeOnly ? true : null
                        };

                        var csv = await ExportService.ExportWorkLogsCsvAsync(filter);
                        var fileName = $"worklogs-export-{DateTime.UtcNow:yyyyMMdd-HHmm}.csv";
                        await JSRuntime.InvokeVoidAsync("downloadFileFromText", fileName, csv, "text/csv");
                        Snackbar.Add($"Downloaded {fileName}", Severity.Success);
                    }
                    else
                    {
                        var format = _exportFormat == "MarkdownExtended" ? "Extended" : "Original";
                        var md = await ExportService.ExportMarkdownAsync(_exportYear, _exportMonth, format, _selectedEmployeeId);

                        if (string.IsNullOrWhiteSpace(md))
                        {
                            Snackbar.Add("No logs found for the selected month and employee.", Severity.Warning);
                            return;
                        }

                        var fileName = $"{_exportYear:D4}-{_exportMonth:D2}.md";
                        await JSRuntime.InvokeVoidAsync("downloadFileFromText", fileName, md, "text/markdown");
                        Snackbar.Add($"Downloaded {fileName}", Severity.Success);
                    }
                    break;

                case "CompTime":
                    var compCsv = await ExportService.ExportCompTimeSummaryCsvAsync();
                    var compFileName = $"comptime-summary-{DateTime.UtcNow:yyyyMMdd}.csv";
                    await JSRuntime.InvokeVoidAsync("downloadFileFromText", compFileName, compCsv, "text/csv");
                    Snackbar.Add($"Downloaded {compFileName}", Severity.Success);
                    break;

                case "Incidents":
                    var incCsv = await ExportService.ExportIncidentsCsvAsync();
                    var incFileName = $"incidents-{DateTime.UtcNow:yyyyMMdd}.csv";
                    await JSRuntime.InvokeVoidAsync("downloadFileFromText", incFileName, incCsv, "text/csv");
                    Snackbar.Add($"Downloaded {incFileName}", Severity.Success);
                    break;

                case "FullBackup":
                    var json = await ExportService.ExportFullBackupJsonAsync();
                    var jsonFileName = $"worksphere-full-backup-{DateTime.UtcNow:yyyyMMdd-HHmmss}.json";
                    await JSRuntime.InvokeVoidAsync("downloadFileFromText", jsonFileName, json, "application/json");
                    Snackbar.Add($"Downloaded {jsonFileName}", Severity.Success);
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Export failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExporting = false;
        }
    }

    private async Task TriggerServerBackupAsync()
    {
        _isExporting = true;
        try
        {
            var result = await ExportService.RunBackupAsync();
            SchedulerState.LastRunUtc = DateTime.UtcNow;
            SchedulerState.LastRunSuccess = result.Success;
            SchedulerState.LastRunMessage = result.Success
                ? $"{result.FilesWritten} files written to {result.OutputDirectory}"
                : result.ErrorMessage;

            if (result.Success)
            {
                RefreshSnapshots();
                Snackbar.Add($"Server backup created: {result.FilesWritten} files written to {result.OutputDirectory}", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Server backup failed: {result.ErrorMessage}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            SchedulerState.LastRunUtc = DateTime.UtcNow;
            SchedulerState.LastRunSuccess = false;
            SchedulerState.LastRunMessage = ex.Message;
            Snackbar.Add($"Server backup error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExporting = false;
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] suffixes = ["B", "KB", "MB", "GB"];
        int i = 0;
        double dblBytes = bytes;
        while (dblBytes >= 1024 && i < suffixes.Length - 1)
        {
            dblBytes /= 1024;
            i++;
        }
        return $"{dblBytes:0.##} {suffixes[i]}";
    }
}
