@using WorkSphere.Models
@using WorkSphere.Services
@using MudBlazor
@inject WorkLogService WorkLogService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Add Date Range Entries</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="4">
            @* Quick Action Shortcuts *@
            <MudText Typo="Typo.caption" Class="mb-n2">Quick Actions</MudText>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Business" OnClick="@(() => SetQuickAction("Work", "In-Office"))">Office</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Home" OnClick="@(() => SetQuickAction("Work", "Work From Home"))">WFH</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.ErrorOutline" OnClick="@(() => SetQuickAction("Work", "Incident Response", earnsComp: true))">GET Comp</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.AlarmOff" OnClick="@(() => SetQuickAction("Leave", "Comp Day", usesComp: true))">USE Comp</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.BeachAccess" OnClick="@(() => SetQuickAction("Leave", "PTO"))">PTO</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.LocalHospital" OnClick="@(() => SetQuickAction("Leave", "Sick Day"))">Sick</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.FamilyRestroom" OnClick="@(() => SetQuickAction("Leave", "FMLA Day"))">FMLA</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Celebration" OnClick="@(() => SetQuickAction("Leave", "Holiday"))">Holiday</MudButton>
            </MudStack>

            <MudDivider Class="my-2" />

            <MudGrid>
                <MudItem xs="6">
                    <MudDatePicker Label="Start Date" @bind-Date="StartDateProxy" PickerVariant="PickerVariant.Dialog" />
                </MudItem>
                <MudItem xs="6">
                    <MudDatePicker Label="End Date" @bind-Date="EndDateProxy" PickerVariant="PickerVariant.Dialog" />
                </MudItem>
                <MudItem xs="12">
                    <MudTimePicker Label="Time (Optional)" @bind-Time="TimeProxy" PickerVariant="PickerVariant.Dialog" MinuteSelectionStep="5" Clearable="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="int" Label="Employee" @bind-Value="_request.EmployeeId">
                        @foreach (var emp in _employees)
                        {
                            <MudSelectItem Value="@emp.Id">@emp.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6">
                    <MudSelect T="string" Label="Main Category" Value="_request.MainCategory" ValueChanged="OnMainCategoryChanged">
                        @foreach (var main in _categoryMap.Keys)
                        {
                            <MudSelectItem Value="@main" />
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6">
                    <MudSelect T="string" Label="Sub-Category" @bind-Value="_request.SubCategory">
                        @foreach (var sub in _currentSubCategories)
                        {
                            <MudSelectItem Value="@sub" />
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-4 mud-background-gray border-all" Style="border: 1px dashed var(--mud-palette-divider);">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2">Range Creation Options</MudText>
                            <MudStack Row="true">
                                <MudCheckBox T="bool" @bind-Value="_request.SkipWeekends" Label="Skip Weekends" Color="Color.Primary" />
                                <MudCheckBox T="bool" @bind-Value="_request.SkipHolidays" Label="Skip Company Holidays" Color="Color.Warning" />
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>
                
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-4 mud-background-gray border-all" Style="border: 1px dashed var(--mud-palette-divider);">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2">Comp Time Settings</MudText>
                            <MudStack Row="true">
                                <MudCheckBox T="bool" @bind-Value="_request.EarnsCompTime" Label="Earns Comp Time" Color="Color.Warning" />
                                <MudCheckBox T="bool" @bind-Value="_request.UsesCompTime" Label="Uses Comp Time" Color="Color.Error" />
                            </MudStack>
                            
                            @if (_request.EarnsCompTime || _request.UsesCompTime)
                            {
                                <MudNumericField Label="@(_request.EarnsCompTime ? "Hours Earned" : "Hours Used")" @bind-Value="_request.Hours" Min="0" Step="0.25m" Variant="Variant.Outlined" />
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12">
                    <div>
                        <MudTextField Label="Details" @bind-Value="_request.Details" Lines="2" />
                        <MudStack Row="true" Spacing="1" Class="mt-1">
                            <MudChip T="string" Size="Size.Small" OnClick="@(() => AddDetail("Unexpected"))" Variant="Variant.Text">+Unexpected</MudChip>
                            <MudChip T="string" Size="Size.Small" OnClick="@(() => AddDetail("Swap"))" Variant="Variant.Text">+Swap</MudChip>
                        </MudStack>
                    </div>
                </MudItem>
            </MudGrid>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Create Entries</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudBlazor.IMudDialogInstance MudDialog { get; set; } = default!;

    private WorkLogRangeRequest _request = new()
    {
        StartDate = DateOnly.FromDateTime(DateTime.Today),
        EndDate = DateOnly.FromDateTime(DateTime.Today),
        MainCategory = "Work",
        SubCategory = "In-Office",
        SkipWeekends = true,
        SkipHolidays = true
    };

    private IEnumerable<Employee> _employees = new List<Employee>();

    private Dictionary<string, List<string>> _categoryMap = new()
    {
        { "Work", new List<string> { "In-Office", "Work From Home", "Remote Location", "Incident Response" } },
        { "Leave", new List<string> { "PTO", "Sick Day", "FMLA Day", "Comp Day", "Holiday" } },
        { "Other", new List<string> { "Other" } }
    };

    private List<string> _currentSubCategories => _categoryMap.ContainsKey(_request.MainCategory) 
        ? _categoryMap[_request.MainCategory] 
        : new List<string> { "Other" };

    protected override async Task OnInitializedAsync()
    {
        _employees = await WorkLogService.GetEmployeesAsync();
        _request.EmployeeId = _employees.FirstOrDefault()?.Id ?? 0;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var offsetMinutes = await JSRuntime.InvokeAsync<int>("getLocalTimezoneOffset");
                var localDateTime = DateTime.UtcNow.AddMinutes(-offsetMinutes);
                var clientToday = DateOnly.FromDateTime(localDateTime);
                _request.StartDate = clientToday;
                _request.EndDate = clientToday;
                StateHasChanged();
            }
            catch
            {
                // Fallback to server time
            }
        }
    }

    private void SetQuickAction(string main, string sub, bool earnsComp = false, bool usesComp = false)
    {
        _request.MainCategory = main;
        _request.SubCategory = sub;
        _request.EarnsCompTime = earnsComp;
        _request.UsesCompTime = usesComp;
        
        Snackbar.Add($"Set to {sub}", Severity.Info);
    }

    private void AddDetail(string text)
    {
        if (string.IsNullOrWhiteSpace(_request.Details))
            _request.Details = text;
        else if (!_request.Details.Contains(text))
            _request.Details += $" ({text})";
    }

    private void OnMainCategoryChanged(string val)
    {
        _request.MainCategory = val;
        _request.SubCategory = _categoryMap[val].First();
    }

    private DateTime? StartDateProxy
    {
        get => _request.StartDate.ToDateTime(TimeOnly.MinValue);
        set => _request.StartDate = value.HasValue ? DateOnly.FromDateTime(value.Value) : DateOnly.FromDateTime(DateTime.Today);
    }

    private DateTime? EndDateProxy
    {
        get => _request.EndDate.ToDateTime(TimeOnly.MinValue);
        set => _request.EndDate = value.HasValue ? DateOnly.FromDateTime(value.Value) : DateOnly.FromDateTime(DateTime.Today);
    }

    private TimeSpan? TimeProxy
    {
        get => _request.LogTime?.ToTimeSpan();
        set => _request.LogTime = value.HasValue ? TimeOnly.FromTimeSpan(value.Value) : null;
    }

    private void Submit() 
    {
        if (_request.EmployeeId == 0)
        {
            Snackbar.Add("An employee must be selected.", Severity.Warning);
            return;
        }

        if (_request.StartDate > _request.EndDate)
        {
            Snackbar.Add("Start date must be on or before end date.", Severity.Warning);
            return;
        }

        MudDialog.Close(DialogResult.Ok(_request));
    }

    private void Cancel() => MudDialog.Cancel();
}
