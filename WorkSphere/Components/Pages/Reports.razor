@page "/reports"
@using WorkSphere.Services
@using WorkSphere.Models
@inject IWorkLogService WorkLogService

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-6" Spacing="3">
    <div>
        <MudText Typo="Typo.h4">Analytics Dashboard</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@GetActiveFilterSummary()</MudText>
    </div>
    
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
        <MudSelect T="string" Label="Date Range" Value="@_selectedRangePreset" ValueChanged="OnRangePresetChanged" Variant="Variant.Outlined" Dense="true" Style="min-width: 160px;">
            <MudSelectItem Value="@("All Time")">All Time</MudSelectItem>
            <MudSelectItem Value="@("This Month")">This Month</MudSelectItem>
            <MudSelectItem Value="@("Last Month")">Last Month</MudSelectItem>
            <MudSelectItem Value="@("Last 30 Days")">Last 30 Days</MudSelectItem>
            <MudSelectItem Value="@("Last 3 Months")">Last 3 Months</MudSelectItem>
            <MudSelectItem Value="@("Last 6 Months")">Last 6 Months</MudSelectItem>
            <MudSelectItem Value="@("This Year")">This Year</MudSelectItem>
            <MudSelectItem Value="@("Custom Range")">Custom Range</MudSelectItem>
        </MudSelect>

        @if (_selectedRangePreset == "Custom Range")
        {
            <MudDateRangePicker Label="Custom Range" DateRange="@_customDateRange" DateRangeChanged="OnCustomDateRangeChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 240px;" AutoClose="true" />
        }

        <MudSelect T="int?" Label="Filter by Employee" Value="@_selectedEmployeeId" ValueChanged="OnEmployeeFilterChanged" Clearable="true" Placeholder="All Employees" Variant="Variant.Outlined" Dense="true" Style="min-width: 180px;">
            <MudSelectItem T="int?" Value="null">All Employees</MudSelectItem>
            @foreach (var emp in _employees)
            {
                <MudSelectItem T="int?" Value="@emp.Id">@emp.Name</MudSelectItem>
            }
        </MudSelect>

        @if (_selectedEmployeeId.HasValue || _selectedRangePreset != "All Time")
        {
            <MudTooltip Text="Reset Filters">
                <MudIconButton Icon="@Icons.Material.Filled.FilterAltOff" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small" OnClick="ResetFilters" />
            </MudTooltip>
        }
    </MudStack>
</MudStack>

<MudGrid>
    @* Summary Cards *@
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4 d-flex flex-column align-center justify-center mud-height-full" Elevation="3">
            <MudIcon Icon="@Icons.Material.Filled.EventNote" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h6">Total Logs</MudText>
            <MudText Typo="Typo.h3">@_totalLogs</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4 d-flex flex-column align-center justify-center mud-height-full" Elevation="3">
            <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Secondary" Size="Size.Large" />
            <MudText Typo="Typo.h6">Team Members</MudText>
            <MudText Typo="Typo.h3">@_totalEmployees</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4 d-flex flex-column align-center justify-center mud-height-full" Elevation="3" Style="border-bottom: 4px solid var(--mud-palette-warning);">
            <MudIcon Icon="@Icons.Material.Filled.Alarm" Color="Color.Warning" Size="Size.Large" />
            <MudText Typo="Typo.h6">Total Comp Balance</MudText>
            <MudText Typo="Typo.h3">@_totalCompBalance</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4 d-flex flex-column align-center justify-center mud-height-full" Elevation="3">
            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Size="Size.Large" />
            <MudText Typo="Typo.h6">Latest Activity</MudText>
            <MudText Typo="Typo.body1">@_lastUpdateDate</MudText>
        </MudPaper>
    </MudItem>

    @* Category Distributions (Row 1) *@
    <MudItem xs="12" md="4">
        <MudCard Elevation="3" Style="overflow: hidden;">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Main Distribution</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Style="height: 300px; display: flex; align-items: center; justify-content: center; padding: 0;">
                <MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@_mainCategoryData.AsChartDataSet()" ChartLabels="@_mainCategoryLabels" Width="200px" Height="200px" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudCard Elevation="3" Style="overflow: hidden;">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Sub Distribution</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Style="height: 300px; display: flex; align-items: center; justify-content: center; padding: 0;">
                <MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@_subCategoryData.AsChartDataSet()" ChartLabels="@_subCategoryLabels" Width="200px" Height="200px" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudCard Elevation="3" Class="mud-height-full" Style="overflow: hidden;">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Comp Time Balance Sheet</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Style="max-height: 300px; overflow-y: auto; padding: 12px;">
                <MudStack Spacing="2">
                    @foreach (var stat in _compTimeStats)
                    {
                        <MudPaper Elevation="0" Class="pa-3 border-all mud-background-gray" Style="border: 1px solid var(--mud-palette-divider); border-radius: 8px;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@stat.Name</MudText>
                                    <MudStack Row="true" Spacing="2">
                                        <MudText Typo="Typo.caption" Color="Color.Success">Earned: @stat.Earned</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Error">Used: @stat.Used</MudText>
                                    </MudStack>
                                </MudStack>
                                <MudChip T="string" Color="@(stat.Balance >= 0 ? Color.Info : Color.Error)" Size="Size.Small" Variant="Variant.Filled">
                                    <b>@stat.Balance h</b>
                                </MudChip>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>

    @* Employee Distribution (Row 2) *@
    <MudItem xs="12" md="6">
        <MudCard Elevation="3" Style="overflow: hidden;">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Logs per Employee</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Style="height: 320px; display: flex; align-items: center; justify-content: center; padding: 0;">
                <MudChart T="double" ChartType="ChartType.Pie" ChartSeries="@_employeeData.AsChartDataSet()" ChartLabels="@_employeeLabels" Width="220px" Height="220px" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard Elevation="3" Style="overflow: hidden;">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Detailed Sub-Category Breakdown</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Style="height: 320px; padding: 16px;">
                <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="@_subCategorySeries" ChartLabels="@_subCategoryLabels" Width="100%" Height="250px" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    @* Activity Matrix *@
    <MudItem xs="12">
        <MudCard Elevation="3">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Team Attendance Matrix</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudSwitch T="bool" Value="@_hideFutureDates" ValueChanged="OnHideFutureDatesChanged" Color="Color.Primary" Label="Hide Future Dates" Class="mr-2" />
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent Class="pa-0">
                @* Desktop View: Table *@
                <div class="d-none d-sm-block">
                    <MudTable Items="@_matrixRows" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Date</MudTh>
                            @foreach (var empName in _allEmployeeNames)
                            {
                                <MudTh Style="text-align: center;">@empName</MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Date">@context.Date.ToString("MM/dd (ddd)")</MudTd>
                            @foreach (var empName in _allEmployeeNames)
                            {
                                var status = context.EmployeeStatus.ContainsKey(empName) ? context.EmployeeStatus[empName] : null;
                                <MudTd Style="text-align: center;">
                                    @if (status != null)
                                    {
                                        <MudTooltip Text="@status.SubCategory">
                                            <MudIcon Icon="@GetStatusIcon(status.SubCategory)" Color="@GetStatusColor(status)" Size="Size.Small" />
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <span style="opacity: 0.2">-</span>
                                    }
                                </MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                </div>

                @* Mobile View: Timeline/Feed *@
                <div class="d-block d-sm-none pa-4">
                    @if (_matrixRows.Any())
                    {
                        <MudStack Spacing="3">
                            @foreach (var row in _matrixRows)
                            {
                                <MudPaper Elevation="0" Class="pa-3" Style="border: 1px solid var(--mud-palette-divider); border-radius: 8px;">
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">@row.Date.ToString("MMMM dd (ddd)")</MudText>
                                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                        @foreach (var empName in _allEmployeeNames)
                                        {
                                            var status = row.EmployeeStatus.ContainsKey(empName) ? row.EmployeeStatus[empName] : null;
                                            @if (status != null)
                                            {
                                                <MudChip T="string" 
                                                        Variant="Variant.Outlined" 
                                                        Size="Size.Small" 
                                                        Color="@GetStatusColor(status)" 
                                                        Icon="@GetStatusIcon(status.SubCategory)"
                                                        Label="true">
                                                    @empName: @status.SubCategory
                                                </MudChip>
                                            }
                                        }
                                        @if (!row.EmployeeStatus.Any())
                                        {
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary italic">No activity recorded</MudText>
                                        }
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Text">No attendance records found for this period.</MudAlert>
                    }
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private int _totalLogs;
    private int _totalEmployees;
    private decimal _totalCompBalance;
    private string _lastUpdateDate = "Never";

    private double[] _mainCategoryData = [];
    private string[] _mainCategoryLabels = [];

    private double[] _subCategoryData = [];
    private string[] _subCategoryLabels = [];
    private List<ChartSeries<double>> _subCategorySeries = new();

    private double[] _employeeData = [];
    private string[] _employeeLabels = [];

    private List<string> _allEmployeeNames = new();
    private List<MatrixRow> _matrixRows = new();
    private List<CompTimeStat> _compTimeStats = new();

    private List<Employee> _employees = new();
    private int? _selectedEmployeeId;
    private List<WorkLog> _allLogs = new();

    private string _selectedRangePreset = "All Time";
    private DateRange? _customDateRange;
    private DateOnly? _filterStartDate;
    private DateOnly? _filterEndDate;
    private bool _hideFutureDates = true;

    protected override async Task OnInitializedAsync()
    {
        _employees = (await WorkLogService.GetEmployeesAsync()).ToList();
        _allLogs = (await WorkLogService.GetWorkLogsAsync()).ToList();
        await CalculateStats();
    }

    private async Task OnEmployeeFilterChanged(int? employeeId)
    {
        _selectedEmployeeId = employeeId;
        await CalculateStats();
    }

    private async Task OnHideFutureDatesChanged(bool value)
    {
        _hideFutureDates = value;
        await CalculateStats();
    }

    private async Task OnRangePresetChanged(string preset)
    {
        _selectedRangePreset = preset;
        var today = DateOnly.FromDateTime(DateTime.Today);

        switch (preset)
        {
            case "This Month":
                _filterStartDate = new DateOnly(today.Year, today.Month, 1);
                _filterEndDate = _filterStartDate.Value.AddMonths(1).AddDays(-1);
                break;
            case "Last Month":
                var firstOfThisMonth = new DateOnly(today.Year, today.Month, 1);
                _filterStartDate = firstOfThisMonth.AddMonths(-1);
                _filterEndDate = firstOfThisMonth.AddDays(-1);
                break;
            case "Last 30 Days":
                _filterStartDate = today.AddDays(-30);
                _filterEndDate = today;
                break;
            case "Last 3 Months":
                _filterStartDate = today.AddMonths(-3);
                _filterEndDate = today;
                break;
            case "Last 6 Months":
                _filterStartDate = today.AddMonths(-6);
                _filterEndDate = today;
                break;
            case "This Year":
                _filterStartDate = new DateOnly(today.Year, 1, 1);
                _filterEndDate = new DateOnly(today.Year, 12, 31);
                break;
            case "Custom Range":
                if (_customDateRange?.Start.HasValue == true && _customDateRange?.End.HasValue == true)
                {
                    _filterStartDate = DateOnly.FromDateTime(_customDateRange.Start.Value);
                    _filterEndDate = DateOnly.FromDateTime(_customDateRange.End.Value);
                }
                break;
            case "All Time":
            default:
                _filterStartDate = null;
                _filterEndDate = null;
                break;
        }

        await CalculateStats();
    }

    private async Task OnCustomDateRangeChanged(DateRange? range)
    {
        _customDateRange = range;
        if (range?.Start.HasValue == true && range?.End.HasValue == true)
        {
            _filterStartDate = DateOnly.FromDateTime(range.Start.Value);
            _filterEndDate = DateOnly.FromDateTime(range.End.Value);
            await CalculateStats();
        }
    }

    private async Task ResetFilters()
    {
        _selectedEmployeeId = null;
        _selectedRangePreset = "All Time";
        _customDateRange = null;
        _filterStartDate = null;
        _filterEndDate = null;
        await CalculateStats();
    }

    private string GetActiveFilterSummary()
    {
        var parts = new List<string>();
        if (_selectedEmployeeId.HasValue)
        {
            var empName = _employees.FirstOrDefault(e => e.Id == _selectedEmployeeId.Value)?.Name ?? "Selected Employee";
            parts.Add($"Employee: {empName}");
        }
        if (_filterStartDate.HasValue || _filterEndDate.HasValue)
        {
            var start = _filterStartDate?.ToString("MM/dd/yyyy") ?? "Beginning";
            var end = _filterEndDate?.ToString("MM/dd/yyyy") ?? "Present";
            parts.Add($"Period: {start} – {end}");
        }
        else
        {
            parts.Add("Period: All Time");
        }
        return string.Join(" | ", parts);
    }

    private async Task CalculateStats()
    {
        var query = _allLogs.AsEnumerable();

        if (_selectedEmployeeId.HasValue)
        {
            query = query.Where(l => l.EmployeeId == _selectedEmployeeId.Value);
        }

        if (_filterStartDate.HasValue)
        {
            query = query.Where(l => l.LogDate >= _filterStartDate.Value);
        }

        if (_filterEndDate.HasValue)
        {
            query = query.Where(l => l.LogDate <= _filterEndDate.Value);
        }

        var filteredLogs = query.ToList();

        // 1. Main Categories
        var mainGroups = filteredLogs.GroupBy(l => l.MainCategory ?? "Unknown")
            .Select(g => new CategoryStatDto(g.Key, g.Count()))
            .OrderByDescending(g => g.Count)
            .ToList();

        _mainCategoryData = mainGroups.Select(s => (double)s.Count).ToArray();
        _mainCategoryLabels = mainGroups.Select(s => s.Name).ToArray();

        // 2. Sub Categories
        var subGroups = filteredLogs.GroupBy(l => l.SubCategory ?? "Unknown")
            .Select(g => new CategoryStatDto(g.Key, g.Count()))
            .OrderByDescending(g => g.Count)
            .ToList();

        _subCategoryData = subGroups.Select(s => (double)s.Count).ToArray();
        _subCategoryLabels = subGroups.Select(s => s.Name).ToArray();
        
        _subCategorySeries = new List<ChartSeries<double>>
        {
            new ChartSeries<double> { Name = "Entries", Data = _subCategoryData }
        };

        // 3. Employee Stats
        var empGroups = filteredLogs.GroupBy(l => l.Employee?.Name ?? "Unknown")
            .Select(g => new EmployeeStatDto(g.Key, g.Count()))
            .OrderByDescending(g => g.Count)
            .ToList();

        _employeeData = empGroups.Select(s => (double)s.Count).ToArray();
        _employeeLabels = empGroups.Select(s => s.Name).ToArray();
        
        _allEmployeeNames = _selectedEmployeeId.HasValue
            ? _employees.Where(e => e.Id == _selectedEmployeeId.Value).Select(e => e.Name).ToList()
            : _employees.Select(e => e.Name).ToList();

        // 4. Comp Time Stats
        var targetEmployees = _selectedEmployeeId.HasValue
            ? _employees.Where(e => e.Id == _selectedEmployeeId.Value).ToList()
            : _employees;

        _compTimeStats = targetEmployees.Select(e =>
        {
            var empLogs = filteredLogs.Where(l => l.EmployeeId == e.Id);
            var earned = empLogs.Where(l => l.EarnsCompTime).Sum(l => l.Hours);
            var used = empLogs.Where(l => l.UsesCompTime).Sum(l => l.Hours);
            return new CompTimeStat
            {
                Id = e.Id,
                Name = e.Name,
                Earned = earned,
                Used = used,
                Balance = earned - used
            };
        }).OrderByDescending(s => s.Balance).ToList();

        _totalCompBalance = _compTimeStats.Sum(s => s.Balance);

        // 5. Matrix Pivot
        var matrixLogs = filteredLogs;
        if (_hideFutureDates)
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            matrixLogs = matrixLogs.Where(l => l.LogDate <= today).ToList();
        }

        if (!_filterStartDate.HasValue && !_filterEndDate.HasValue)
        {
            var cutoff = DateOnly.FromDateTime(DateTime.Today.AddDays(-30));
            matrixLogs = matrixLogs.Where(l => l.LogDate >= cutoff).ToList();
        }

        _matrixRows = matrixLogs
            .GroupBy(l => l.LogDate)
            .OrderByDescending(g => g.Key)
            .Select(g => new MatrixRow 
            { 
                Date = g.Key ?? default,
                EmployeeStatus = g.GroupBy(l => l.Employee?.Name ?? "Unknown")
                                  .ToDictionary(ge => ge.Key, ge => ge.First())
            })
            .ToList();

        _totalLogs = filteredLogs.Count;
        _totalEmployees = _selectedEmployeeId.HasValue ? 1 : filteredLogs.Select(l => l.EmployeeId).Distinct().Count();
        
        if (filteredLogs.Any())
        {
            _lastUpdateDate = filteredLogs.Max(l => l.LogDate)?.ToString("MM/dd/yyyy") ?? "Never";
        }
        else
        {
            _lastUpdateDate = "No activity";
        }

        await Task.CompletedTask;
    }

    private string GetStatusIcon(string subCat) => subCat switch
    {
        "In-Office" => Icons.Material.Filled.Business,
        "Work From Home" => Icons.Material.Filled.Home,
        "Remote Location" => Icons.Material.Filled.Factory,
        "PTO" => Icons.Material.Filled.BeachAccess,
        "Sick Day" => Icons.Material.Filled.LocalHospital,
        "FMLA Day" => Icons.Material.Filled.FamilyRestroom,
        "Meeting" => Icons.Material.Filled.Groups,
        "Training" => Icons.Material.Filled.School,
        "Incident Response" => Icons.Material.Filled.ErrorOutline,
        "Comp Day" => Icons.Material.Filled.AlarmOff,
        "Holiday" => Icons.Material.Filled.Celebration,
        _ => Icons.Material.Filled.Label
    };

    private Color GetStatusColor(WorkLog log) => log.SubCategory switch
    {
        "In-Office" => Color.Info,
        "Work From Home" => Color.Tertiary,
        "Remote Location" => Color.Secondary,
        "PTO" => Color.Success,
        "Sick Day" => Color.Error,
        "FMLA Day" => Color.Error,
        "Comp Day" => Color.Success,
        _ => log.MainCategory switch
        {
            "Work" => Color.Primary,
            "Leave" => Color.Error,
            _ => Color.Default
        }
    };

    public class MatrixRow
    {
        public DateOnly Date { get; set; }
        public Dictionary<string, WorkLog> EmployeeStatus { get; set; } = new();
    }

    public class CompTimeStat
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public decimal Earned { get; set; }
        public decimal Used { get; set; }
        public decimal Balance { get; set; }
    }
}
