@page "/reports"
@using WorkSphere.Services
@using WorkSphere.Models
@inject WorkLogService WorkLogService

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
    <MudText Typo="Typo.h4">Analytics Dashboard</MudText>
    <MudPaper Elevation="0" Class="pa-2" Style="width: 300px;">
        <MudSelect T="int?" Label="Filter by Employee" Value="@_selectedEmployeeId" ValueChanged="OnEmployeeFilterChanged" Clearable="true" Placeholder="All Employees" Variant="Variant.Outlined" Dense="true">
            <MudSelectItem T="int?" Value="null">All Employees</MudSelectItem>
            @foreach (var emp in _employees)
            {
                <MudSelectItem T="int?" Value="@emp.Id">@emp.Name</MudSelectItem>
            }
        </MudSelect>
    </MudPaper>
</MudStack>

<MudGrid>
    @* Summary Cards *@
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4 d-flex flex-column align-center justify-center mud-height-full" Elevation="3">
            <MudIcon Icon="@Icons.Material.Filled.EventNote" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h6">Total Logs</MudText>
            <MudText Typo="Typo.h3">@_totalLogs</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4 d-flex flex-column align-center justify-center mud-height-full" Elevation="3">
            <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Secondary" Size="Size.Large" />
            <MudText Typo="Typo.h6">Team Members</MudText>
            <MudText Typo="Typo.h3">@_totalEmployees</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4 d-flex flex-column align-center justify-center mud-height-full" Elevation="3" Style="border-bottom: 4px solid var(--mud-palette-warning);">
            <MudIcon Icon="@Icons.Material.Filled.Alarm" Color="Color.Warning" Size="Size.Large" />
            <MudText Typo="Typo.h6">Total Comp Balance</MudText>
            <MudText Typo="Typo.h3">@_totalCompBalance</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4 d-flex flex-column align-center justify-center mud-height-full" Elevation="3">
            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Size="Size.Large" />
            <MudText Typo="Typo.h6">Latest Activity</MudText>
            <MudText Typo="Typo.body1">@_lastUpdateDate</MudText>
        </MudPaper>
    </MudItem>

    @* Category Distributions (Row 1) *@
    <MudItem xs="12" md="4">
        <MudCard Elevation="3" Style="overflow: hidden;">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Main Distribution</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Style="height: 300px; display: flex; align-items: center; justify-content: center; padding: 0;">
                <MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@_mainCategoryData.AsChartDataSet()" ChartLabels="@_mainCategoryLabels" Width="200px" Height="200px" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudCard Elevation="3" Style="overflow: hidden;">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Sub Distribution</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Style="height: 300px; display: flex; align-items: center; justify-content: center; padding: 0;">
                <MudChart T="double" ChartType="ChartType.Donut" ChartSeries="@_subCategoryData.AsChartDataSet()" ChartLabels="@_subCategoryLabels" Width="200px" Height="200px" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudCard Elevation="3" Class="mud-height-full" Style="overflow: hidden;">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Comp Time Balance Sheet</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Style="max-height: 300px; overflow-y: auto; padding: 12px;">
                <MudStack Spacing="2">
                    @foreach (var stat in _compTimeStats)
                    {
                        <MudPaper Elevation="0" Class="pa-3 border-all mud-background-gray" Style="border: 1px solid var(--mud-palette-divider); border-radius: 8px;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@stat.Name</MudText>
                                    <MudStack Row="true" Spacing="2">
                                        <MudText Typo="Typo.caption" Color="Color.Success">Earned: @stat.Earned</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Error">Used: @stat.Used</MudText>
                                    </MudStack>
                                </MudStack>
                                <MudChip T="string" Color="@(stat.Balance >= 0 ? Color.Info : Color.Error)" Size="Size.Small" Variant="Variant.Filled">
                                    <b>@stat.Balance h</b>
                                </MudChip>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>

    @* Employee Distribution (Row 2) *@
    <MudItem xs="12" md="6">
        <MudCard Elevation="3" Style="overflow: hidden;">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Logs per Employee</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Style="height: 320px; display: flex; align-items: center; justify-content: center; padding: 0;">
                <MudChart T="double" ChartType="ChartType.Pie" ChartSeries="@_employeeData.AsChartDataSet()" ChartLabels="@_employeeLabels" Width="220px" Height="220px" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard Elevation="3" Style="overflow: hidden;">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Detailed Sub-Category Breakdown</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Style="height: 320px; padding: 16px;">
                <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="@_subCategorySeries" ChartLabels="@_subCategoryLabels" Width="100%" Height="250px" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    @* Activity Matrix *@
    <MudItem xs="12">
        <MudCard Elevation="3">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Team Attendance Matrix (Last 30 Days)</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pa-0">
                @* Desktop View: Table *@
                <div class="d-none d-sm-block">
                    <MudTable Items="@_matrixRows" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Date</MudTh>
                            @foreach (var empName in _allEmployeeNames)
                            {
                                <MudTh Style="text-align: center;">@empName</MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Date">@context.Date.ToString("MM/dd (ddd)")</MudTd>
                            @foreach (var empName in _allEmployeeNames)
                            {
                                var status = context.EmployeeStatus.ContainsKey(empName) ? context.EmployeeStatus[empName] : null;
                                <MudTd Style="text-align: center;">
                                    @if (status != null)
                                    {
                                        <MudTooltip Text="@status.SubCategory">
                                            <MudIcon Icon="@GetStatusIcon(status.SubCategory)" Color="@GetStatusColor(status.MainCategory)" Size="Size.Small" />
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <span style="opacity: 0.2">-</span>
                                    }
                                </MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                </div>

                @* Mobile View: Timeline/Feed *@
                <div class="d-block d-sm-none pa-4">
                    <MudStack Spacing="3">
                        @foreach (var row in _matrixRows)
                        {
                            <MudPaper Elevation="0" Class="pa-3" Style="border: 1px solid var(--mud-palette-divider); border-radius: 8px;">
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">@row.Date.ToString("MMMM dd (ddd)")</MudText>
                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                    @foreach (var empName in _allEmployeeNames)
                                    {
                                        var status = row.EmployeeStatus.ContainsKey(empName) ? row.EmployeeStatus[empName] : null;
                                        @if (status != null)
                                        {
                                            <MudChip T="string" 
                                                    Variant="Variant.Outlined" 
                                                    Size="Size.Small" 
                                                    Color="@GetStatusColor(status.MainCategory)" 
                                                    Icon="@GetStatusIcon(status.SubCategory)"
                                                    Label="true">
                                                @empName: @status.SubCategory
                                            </MudChip>
                                        }
                                    }
                                    @if (!row.EmployeeStatus.Any())
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary italic">No activity recorded</MudText>
                                    }
                                </MudStack>
                            </MudPaper>
                        }
                    </MudStack>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private int _totalLogs;
    private int _totalEmployees;
    private decimal _totalCompBalance;
    private string _lastUpdateDate = "Never";

    private double[] _mainCategoryData = [];
    private string[] _mainCategoryLabels = [];

    private double[] _subCategoryData = [];
    private string[] _subCategoryLabels = [];
    private List<ChartSeries<double>> _subCategorySeries = new();

    private double[] _employeeData = [];
    private string[] _employeeLabels = [];

    private List<string> _allEmployeeNames = new();
    private List<MatrixRow> _matrixRows = new();
    private List<CompTimeStat> _compTimeStats = new();

    private List<Employee> _employees = new();
    private int? _selectedEmployeeId;
    private List<WorkLog> _allLogs = new();

    protected override async Task OnInitializedAsync()
    {
        _employees = (await WorkLogService.GetEmployeesAsync()).ToList();
        _allLogs = (await WorkLogService.GetWorkLogsAsync()).ToList();
        await CalculateStats();
    }

    private async Task OnEmployeeFilterChanged(int? employeeId)
    {
        _selectedEmployeeId = employeeId;
        await CalculateStats();
    }

    private async Task CalculateStats()
    {
        var filteredLogs = _selectedEmployeeId.HasValue 
            ? _allLogs.Where(l => l.EmployeeId == _selectedEmployeeId.Value).ToList() 
            : _allLogs;

        // 1. Main Categories
        var mainGroups = filteredLogs.GroupBy(l => l.MainCategory)
            .Select(g => new { maincategory = g.Key, count = g.Count() })
            .ToList();
        _mainCategoryData = mainGroups.Select(s => (double)s.count).ToArray();
        _mainCategoryLabels = mainGroups.Select(s => s.maincategory ?? "Unknown").ToArray();

        // 2. Sub Categories
        var subGroups = filteredLogs.GroupBy(l => l.SubCategory)
            .Select(g => new { category = g.Key, count = g.Count() })
            .ToList();
        _subCategoryData = subGroups.Select(s => (double)s.count).ToArray();
        _subCategoryLabels = subGroups.Select(s => s.category ?? "Unknown").ToArray();
        
        _subCategorySeries = new List<ChartSeries<double>>
        {
            new ChartSeries<double> { Name = "Entries", Data = _subCategoryData }
        };

        // 3. Employee Stats (Distribution always shows all, but we highlight if filtered)
        var empGroups = filteredLogs.GroupBy(l => l.Employee?.Name ?? "Unknown")
            .Select(g => new { name = g.Key, count = g.Count() })
            .ToList();
        _employeeData = empGroups.Select(s => (double)s.count).ToArray();
        _employeeLabels = empGroups.Select(s => s.name).ToArray();
        
        if (!_selectedEmployeeId.HasValue)
        {
            _allEmployeeNames = _employees.Select(e => e.Name).ToList();
        }
        else
        {
            _allEmployeeNames = _employees.Where(e => e.Id == _selectedEmployeeId).Select(e => e.Name).ToList();
        }

        // 4. Comp Time Stats
        var allCompStats = (await WorkLogService.GetCompTimeStatsAsync()).ToList();
        _compTimeStats = allCompStats.Select(s => new CompTimeStat 
        { 
            Name = (string)(Convert.ToString(GetValue<object>(s, "name")) ?? "Unknown"), 
            Earned = (decimal)Convert.ToDecimal(GetValue<object>(s, "earned")), 
            Used = (decimal)Convert.ToDecimal(GetValue<object>(s, "used")), 
            Balance = (decimal)Convert.ToDecimal(GetValue<object>(s, "balance")),
            Id = (int)Convert.ToInt32(GetValue<object>(s, "id") ?? 0)
        }).ToList();

        if (_selectedEmployeeId.HasValue)
        {
            _compTimeStats = _compTimeStats.Where(s => s.Id == _selectedEmployeeId.Value).ToList();
        }

        _totalCompBalance = _compTimeStats.Sum(s => s.Balance);

        // 5. Matrix Pivot
        var cutoff = DateOnly.FromDateTime(DateTime.Today.AddDays(-30));
        _matrixRows = filteredLogs
            .Where(l => l.LogDate >= cutoff)
            .GroupBy(l => l.LogDate)
            .OrderByDescending(g => g.Key)
            .Select(g => new MatrixRow 
            { 
                Date = g.Key ?? default,
                EmployeeStatus = g.GroupBy(l => l.Employee?.Name ?? "Unknown")
                                  .ToDictionary(ge => ge.Key, ge => ge.First())
            })
            .ToList();

        _totalLogs = filteredLogs.Count;
        _totalEmployees = _selectedEmployeeId.HasValue ? 1 : _employees.Count;
        
        if (filteredLogs.Any())
        {
            _lastUpdateDate = filteredLogs.Max(l => l.LogDate)?.ToString("MM/dd/yyyy") ?? "Never";
        }
        else
        {
            _lastUpdateDate = "No activity";
        }
    }

    private string GetStatusIcon(string subCat) => subCat switch
    {
        "In-Office" => Icons.Material.Filled.Business,
        "Work From Home" => Icons.Material.Filled.Home,
        "Remote Location" => Icons.Material.Filled.Factory,
        "PTO" => Icons.Material.Filled.BeachAccess,
        "Sick Day" => Icons.Material.Filled.LocalHospital,
        "FMLA Day" => Icons.Material.Filled.FamilyRestroom,
        "Meeting" => Icons.Material.Filled.Groups,
        "Training" => Icons.Material.Filled.School,
        "Incident Response" => Icons.Material.Filled.ErrorOutline,
        "Comp Day" => Icons.Material.Filled.AlarmOff,
        _ => Icons.Material.Filled.Label
    };

    private Color GetStatusColor(string mainCat) => mainCat switch
    {
        "Work" => Color.Primary,
        "Leave" => Color.Error,
        _ => Color.Default
    };

    private T? GetValue<T>(dynamic obj, string propertyName)
    {
        var dict = (IDictionary<string, object>)obj;
        var key = dict.Keys.FirstOrDefault(k => k.Equals(propertyName, StringComparison.OrdinalIgnoreCase));
        if (key == null) return default;
        return (T)dict[key];
    }

    public class MatrixRow
    {
        public DateOnly Date { get; set; }
        public Dictionary<string, WorkLog> EmployeeStatus { get; set; } = new();
    }

    public class CompTimeStat
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public decimal Earned { get; set; }
        public decimal Used { get; set; }
        public decimal Balance { get; set; }
    }
}
