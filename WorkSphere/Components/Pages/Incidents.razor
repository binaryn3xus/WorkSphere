@page "/incidents"
@rendermode InteractiveServer
@using WorkSphere.Models
@using WorkSphere.Services
@using MudBlazor
@inject WorkLogService WorkLogService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
        <MudText Typo="Typo.h4">Incident Tracker</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@NavigateToNewIncident">New Incident</MudButton>
    </MudStack>

    <MudStack Spacing="4">
        @foreach (var incident in _incidents)
        {
            <MudPaper Class="pa-4 incident-card" Elevation="1">
                <MudGrid>
                    @* Content Area (Non-clickable) *@
                    <MudItem xs="12" sm="8">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary font-weight-bold">@incident.TicketNumber</MudText>
                                <MudChip T="string" Color="@(incident.IsClosed ? Color.Success : Color.Warning)" Size="Size.Small" Variant="Variant.Text" Class="ml-2">
                                    @(incident.IsClosed ? "Closed" : "Open")
                                </MudChip>
                                @if (incident.TotalCompHours > 0)
                                {
                                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.AccessTime" Variant="Variant.Outlined">
                                        @incident.TotalCompHours h
                                    </MudChip>
                                }
                            </MudStack>
                            <MudText Typo="Typo.h6">@incident.Title</MudText>
                            <div class="details-preview mt-1">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary truncate-text">
                                    @((MarkupString)GetPlainTextPreview(incident.Details))
                                </MudText>
                            </div>
                        </MudStack>
                    </MudItem>

                    @* Dates and Actions Area *@
                    <MudItem xs="12" sm="4">
                        <MudStack AlignItems="AlignItems.End" Justify="Justify.Center" Class="h-100">
                            <div style="text-align: right;" class="mb-2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="mud-text-secondary" />
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                        @incident.StartedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                    </MudText>
                                </MudStack>
                                @if (incident.IsClosed && incident.EndedAt != null)
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                            Closed @incident.EndedAt.Value.ToLocalTime().ToString("MMM dd, yyyy")
                                        </MudText>
                                    </MudStack>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Warning" Class="italic">In Progress</MudText>
                                }
                            </div>

                            <MudStack Row="true" Spacing="1">
                                <MudButton Variant="Variant.Outlined" 
                                           Size="Size.Small" 
                                           StartIcon="@Icons.Material.Filled.Edit" 
                                           OnClick="@(() => NavigateToEditIncident(incident.Id))">
                                    Edit
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" 
                                           Color="Color.Error" 
                                           Size="Size.Small" 
                                           StartIcon="@Icons.Material.Filled.Delete" 
                                           OnClick="@(() => DeleteIncident(incident.Id, incident.TicketNumber))">
                                    Delete
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
    </MudStack>
</MudContainer>

<style>
    .incident-card {
        transition: all 0.2s ease-in-out;
        border-left: 4px solid transparent;
    }
    .incident-card:hover {
        transform: translateX(4px);
        background-color: var(--mud-palette-background-grey);
        border-left: 4px solid var(--mud-palette-primary);
    }
    .truncate-text {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .font-weight-bold { font-weight: 700; }
    .italic { font-style: italic; }
</style>

@code {
    private IEnumerable<IncidentViewModel> _incidents = new List<IncidentViewModel>();

    protected override async Task OnInitializedAsync()
    {
        await LoadIncidents();
    }

    private async Task LoadIncidents()
    {
        _incidents = await WorkLogService.GetIncidentStatsAsync();
    }

    private string GetPlainTextPreview(string? markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return "No details provided.";
        
        // Very basic strip of some markdown characters for the preview
        var plainText = markdown
            .Replace("#", "")
            .Replace("*", "")
            .Replace("`", "")
            .Replace("[", "")
            .Replace("]", "")
            .Replace("(", "")
            .Replace(")", "");
            
        return plainText.Length > 200 ? plainText.Substring(0, 197) + "..." : plainText;
    }

    private void NavigateToNewIncident()
    {
        NavigationManager.NavigateTo("/incidents/new");
    }

    private void NavigateToEditIncident(int id)
    {
        NavigationManager.NavigateTo($"/incidents/edit/{id}");
    }

    private async Task DeleteIncident(int id, string ticketNumber)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync("Confirm Delete", $"Are you sure you want to delete incident {ticketNumber}?", yesText: "Delete", cancelText: "Cancel");
        if (confirm == true)
        {
            await WorkLogService.DeleteIncidentAsync(id);
            Snackbar.Add("Incident deleted", Severity.Info);
            await LoadIncidents();
        }
    }
}
