@page "/schedule"
@using WorkSphere.Models
@using WorkSphere.Services
@using System.Globalization
@using System.IO
@using System.Text
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Hosting
@inject IWorkLogService WorkLogService
@inject MigrationService MigrationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IConfiguration Configuration
@inject IWebHostEnvironment Env
@inject IJSRuntime JSRuntime

<MudText Typo="Typo.h4" GutterBottom="true">Team Schedule</MudText>

<MudPaper Elevation="0" Class="pa-4 mb-4 schedule-mobile-tab-picker">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="schedule-mobile-tab-picker__header">
        <MudIcon Icon="@GetScheduleTabIcon(_activeScheduleTabIndex)" Color="Color.Primary" />
        <MudText Typo="Typo.subtitle2">Jump to section</MudText>
    </MudStack>
    <MudSelect T="int"
               Label="Team Schedule section"
               Value="@_activeScheduleTabIndex"
               ValueChanged="OnActiveScheduleTabChanged"
               Dense="true"
               Variant="Variant.Outlined"
               Class="schedule-mobile-tab-picker__select">
        @for (var index = 0; index < ScheduleTabOptions.Length; index++)
        {
            var option = ScheduleTabOptions[index];
            <MudSelectItem Value="@index">@option.Label</MudSelectItem>
        }
    </MudSelect>
</MudPaper>

<MudTabs Elevation="3"
         Rounded="true"
         ApplyEffectsToContainer="true"
         Color="Color.Primary"
         Class="schedule-tabs"
         ActivePanelIndex="@_activeScheduleTabIndex"
         ActivePanelIndexChanged="OnActiveScheduleTabChanged">
    @* --- CALENDAR TAB --- *@
    <MudTabPanel Text="@ScheduleTabOptions[0].Label" Icon="@ScheduleTabOptions[0].Icon">
        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4 schedule-calendar-toolbar">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="schedule-calendar-navigation">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="PreviousMonth" aria-label="Previous month" />
                <MudText Typo="Typo.h5" Class="schedule-calendar-month-label">@_currentDate.ToString("MMMM yyyy")</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="NextMonth" aria-label="Next month" />
            </MudStack>
            <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled" Class="schedule-calendar-actions">
                <MudButton OnClick="@(() => OpenAddDialog(null))" StartIcon="@Icons.Material.Filled.Add">Add Entry</MudButton>
                <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem OnClick="OpenRangeDialog" Icon="@Icons.Material.Filled.DateRange" IconColor="Color.Info">Add Date Range</MudMenuItem>
                    <MudMenuItem OnClick="OpenCompanyHolidayDialog" Icon="@Icons.Material.Filled.Celebration" IconColor="Color.Warning">Company Holiday</MudMenuItem>
                </MudMenu>
            </MudButtonGroup>
        </MudStack>

        <div class="calendar-surface" @onclick="HideCalendarContextMenu">
            <div class="d-block d-sm-none" data-testid="mobile-calendar-agenda">
                <MudStack Spacing="2" Class="mobile-calendar-agenda">
                    @foreach (var date in DaysInCurrentMonth)
                    {
                        var dayLogs = GetLogsForDate(date).ToList();

                        <MudPaper Elevation="0"
                                  Class="@($"mobile-calendar-day-card {(date == DateOnly.FromDateTime(DateTime.Today) ? "today" : string.Empty)}")"
                                  data-mobile-calendar-day="@date.ToString("yyyy-MM-dd")">
                            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@date.ToString("dddd, MMMM d")</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@GetMobileDaySummary(dayLogs.Count)</MudText>
                                </MudStack>
                                <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1" Class="mobile-calendar-day-actions">
                                    @if (date == DateOnly.FromDateTime(DateTime.Today))
                                    {
                                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Text">Today</MudChip>
                                    }
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenAddDialog(date))">Add</MudButton>
                                    @if (CanPasteCopiedEntryTo(date))
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ContentPaste" OnClick="@(() => PasteCopiedEntryToDateAsync(date))">Paste</MudButton>
                                    }
                                </MudStack>
                            </MudStack>

                            @if (dayLogs.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mobile-calendar-empty">No schedule entries for this day.</MudText>
                            }
                            else
                            {
                                <MudStack Spacing="2">
                                    @foreach (var log in dayLogs)
                                    {
                                        <MudPaper Elevation="0" Class="@($"mobile-log-card {GetLogCssClass(log)}")" data-mobile-log-id="@log.Id">
                                            <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mb-2" Spacing="2">
                                                <MudStack Spacing="0" Class="mobile-log-primary">
                                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@log.Employee?.Name</MudText>
                                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@GetMobileLogMeta(log)</MudText>
                                                </MudStack>
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@GetLogColor(log)" Icon="@GetLogIcon(log)">@log.SubCategory</MudChip>
                                            </MudStack>

                                            @if (!string.IsNullOrWhiteSpace(log.Details))
                                            {
                                                <MudText Typo="Typo.body2" Class="mobile-log-details">@log.Details</MudText>
                                            }

                                            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-2">
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@log.MainCategory</MudText>
                                                <MudStack Row="true" Spacing="0" Class="mobile-log-actions">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Medium" aria-label="@($"Edit mobile log {log.Id}")" OnClick="@(() => OpenEditDialog(log))" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Secondary" Size="Size.Medium" aria-label="@($"Copy mobile log {log.Id}")" OnClick="@(() => CopyLog(log))" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Medium" aria-label="@($"Delete mobile log {log.Id}")" OnClick="@(() => DeleteLog(log, true))" />
                                                </MudStack>
                                            </MudStack>
                                        </MudPaper>
                                    }
                                </MudStack>
                            }
                        </MudPaper>
                    }
                </MudStack>
            </div>

            <div class="d-none d-sm-block">
                <div class="calendar-grid">
            @foreach (var day in _daysOfWeek)
            {
                <div class="calendar-header">@day</div>
            }

            @for (int i = 0; i < _offsetDays; i++)
            {
                <div class="calendar-day empty"></div>
            }

            @for (int day = 1; day <= _daysInMonth; day++)
            {
                var date = new DateOnly(_currentDate.Year, _currentDate.Month, day);
                var dayLogs = _logs.Where(l => l.LogDate == date).OrderBy(l => l.Employee?.Name ?? string.Empty, System.StringComparer.OrdinalIgnoreCase).ToList();
                
                <div class="calendar-day @(date == DateOnly.FromDateTime(DateTime.Today) ? "today" : "")"
                     data-calendar-day="@date.ToString("yyyy-MM-dd")"
                     @ondblclick="@(() => OpenAddDialog(date))"
                     @oncontextmenu="@((MouseEventArgs args) => OpenDayContextMenu(args, date))"
                     @oncontextmenu:preventDefault>
                    <div class="day-number">@day</div>
                    <div class="day-content">
                        @foreach (var log in dayLogs)
                        {
                            <MudTooltip Text="@($"{log.Employee?.Name}: {log.SubCategory} - {log.Details}")" Arrow="true" Placement="Placement.Top">
                                <div class="log-namecard @GetLogCssClass(log)"
                                     data-log-id="@log.Id"
                                     @onclick="@(() => OpenEditDialog(log))"
                                     @onclick:stopPropagation
                                     @ondblclick:stopPropagation
                                     @oncontextmenu="@((MouseEventArgs args) => OpenLogContextMenu(args, log))"
                                     @oncontextmenu:preventDefault
                                     @oncontextmenu:stopPropagation>
                                    <div class="card-top">
                                        <span class="emp-name">@log.Employee?.Name</span>
                                        @if (log.LogTime.HasValue && log.LogTime != TimeOnly.MinValue)
                                        {
                                            <span class="log-time">@log.LogTime.Value.ToString("h:mm tt")</span>
                                        }
                                    </div>
                                    <div class="card-bottom">
                                        <MudIcon Icon="@GetLogIcon(log)" Size="Size.Small" Class="cat-icon" />
                                        <span class="cat-label">@log.SubCategory</span>
                                        @if (!string.IsNullOrWhiteSpace(log.Details))
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Notes" Size="Size.Small" Class="details-icon" />
                                        }
                                    </div>
                                </div>
                            </MudTooltip>
                        }
                    </div>
                </div>
            }
        </div>

                @if (_calendarContextMenu.IsVisible)
                {
                    <div class="calendar-context-menu"
                         @ref="_calendarContextMenuElement"
                         data-testid="calendar-context-menu"
                         style="left:@($"{_calendarContextMenu.X}px"); top:@($"{_calendarContextMenu.Y}px");"
                         @onclick:stopPropagation>
                        @if (_calendarContextMenu.Log is not null)
                        {
                            <button type="button"
                                    class="calendar-context-menu__item"
                                    data-testid="calendar-copy-action"
                                    @onclick="CopyContextMenuLog">
                                Copy Entry
                            </button>

                            @if (CanDeleteCalendarContextMenuLog)
                            {
                                <button type="button"
                                        class="calendar-context-menu__item calendar-context-menu__item--danger"
                                        data-testid="calendar-delete-action"
                                        @onclick="DeleteContextMenuLogAsync">
                                    Delete Entry
                                </button>
                            }
                        }

                        @if (_calendarContextMenu.TargetDate.HasValue)
                        {
                            <button type="button"
                                    class="calendar-context-menu__item"
                                    data-testid="calendar-paste-action"
                                    @onclick="PasteContextMenuEntryAsync">
                                Paste Entry
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </MudTabPanel>

    @* --- LOGS TAB --- *@
    <MudTabPanel Text="@ScheduleTabOptions[1].Label" Icon="@ScheduleTabOptions[1].Icon">
        <MudStack Row="true" Class="mb-4 schedule-list-toolbar schedule-toolbar" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
            <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled">
                <MudButton OnClick="@(() => OpenAddDialog(null))" StartIcon="@Icons.Material.Filled.Add">Add Entry</MudButton>
                <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem OnClick="OpenRangeDialog" Icon="@Icons.Material.Filled.DateRange" IconColor="Color.Info">Add Date Range</MudMenuItem>
                    <MudMenuItem OnClick="OpenCompanyHolidayDialog" Icon="@Icons.Material.Filled.Celebration" IconColor="Color.Warning">Company Holiday</MudMenuItem>
                </MudMenu>
            </MudButtonGroup>
            @if (VisibleSelectedLogCount > 0)
            {
                <MudButton Color="Color.Error"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="DeleteSelectedLogs"
                           Disabled="_isDeletingLogs">
                    Delete Selected (@VisibleSelectedLogCount)
                </MudButton>
            }
            <MudCheckBox T="bool" @bind-Value="_needsReviewOnly" Label="Needs Review" Color="Color.Warning" />
            <MudSpacer />
            <MudTextField @bind-Value="_searchString"
                          Placeholder="Search records"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Class="mt-0 schedule-toolbar__search" />
        </MudStack>

        <div class="d-block d-sm-none">
            @if (FilteredLogs.Any())
            {
                <MudStack Spacing="2">
                    @foreach (var log in FilteredLogs)
                    {
                        <MudPaper Elevation="0" Class="@($"pa-4 mobile-feed-card {GetLogCssClass(log)}")" Style="@GetRowStyle(log, 0)">
                            <MudStack Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@log.Employee?.Name</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @GetFormattedLogDate(log.LogDate)
                                            @if (log.LogTime.HasValue && log.LogTime != TimeOnly.MinValue)
                                            {
                                                <span> • @GetFormattedLogTime(log.LogTime)</span>
                                            }
                                        </MudText>
                                    </MudStack>

                                    <MudCheckBox T="bool"
                                                 Value="@IsLogSelected(log.Id)"
                                                 ValueChanged="@((bool selected) => ToggleLogSelection(log.Id, selected))"
                                                 Disabled="_isDeletingLogs"
                                                 Label="Select"
                                                 aria-label="@($"Select mobile log {log.Id}")" />
                                </MudStack>

                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">@log.MainCategory</MudChip>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Icon="@GetLogIcon(log)">@log.SubCategory</MudChip>
                                    @if (log.EarnsCompTime)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Icon="@Icons.Material.Filled.Schedule">Earns Comp</MudChip>
                                    }
                                    @if (log.UsesCompTime)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Icon="@Icons.Material.Filled.History">Uses Comp</MudChip>
                                    }
                                </MudStack>

                                @if (!string.IsNullOrWhiteSpace(log.Details))
                                {
                                    <MudPaper Elevation="0" Class="pa-3 mobile-feed-card__details">
                                        <MudText Typo="Typo.body2">@log.Details</MudText>
                                    </MudPaper>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary italic">No additional details provided.</MudText>
                                }

                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Log #@log.Id</MudText>
                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenEditDialog(log))">
                                            Edit
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteLog(log.Id))">
                                            Delete
                                        </MudButton>
                                    </MudStack>
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No records match the current filters.</MudAlert>
            }
        </div>

        <div class="d-none d-sm-block schedule-table-shell">
            <MudTable Items="@FilteredLogs" RowStyleFunc="GetRowStyle" Dense="true" Hover="true">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Daily Records</MudText>
                    <MudSpacer />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>
                        <MudCheckBox T="bool?"
                                     Value="@SelectAllCheckboxState"
                                     ValueChanged="ToggleSelectAllVisibleLogs"
                                     TriState="true"
                                     Disabled="!FilteredLogs.Any() || _isDeletingLogs"
                                     aria-label="Select all visible logs" />
                    </MudTh>
                    <MudTh>Date</MudTh>
                    <MudTh>Time</MudTh>
                    <MudTh>Employee</MudTh>
                    <MudTh>Main Category</MudTh>
                    <MudTh>Sub-Category</MudTh>
                    <MudTh>Details</MudTh>
                    <MudTh Style="width: 100px;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Select">
                        <MudCheckBox T="bool"
                                     Value="@IsLogSelected(context.Id)"
                                     ValueChanged="@((bool selected) => ToggleLogSelection(context.Id, selected))"
                                     Disabled="_isDeletingLogs"
                                     aria-label="@($"Select log {context.Id}")" />
                    </MudTd>
                    <MudTd DataLabel="Date">@context.LogDate?.ToString("MM/dd/yyyy")</MudTd>
                    <MudTd DataLabel="Time">@context.LogTime?.ToString("HH:mm")</MudTd>
                    <MudTd DataLabel="Employee">@context.Employee?.Name</MudTd>
                    <MudTd DataLabel="Main Category">@context.MainCategory</MudTd>
                    <MudTd DataLabel="Sub-Category">@context.SubCategory</MudTd>
                    <MudTd DataLabel="Details">@context.Details</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenEditDialog(context))" Size="Size.Small" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteLog(context.Id))" Size="Size.Small" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </div>
    </MudTabPanel>

    @* --- AUDIT TAB --- *@
    <MudTabPanel Text="@ScheduleTabOptions[2].Label" Icon="@ScheduleTabOptions[2].Icon">
        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-4 schedule-audit-toolbar">
            <MudSelect T="int" Label="Year" Value="@_auditYear" ValueChanged="OnAuditYearChanged" Dense="true" Class="schedule-audit-select schedule-audit-select--year" Style="max-width: 120px;">
                @foreach (var y in Enumerable.Range(2024, DateTime.Today.Year - 2024 + 2))
                {
                    <MudSelectItem Value="@y" />
                }
            </MudSelect>
            <MudSelect T="int" Label="Month" Value="@_auditMonth" ValueChanged="OnAuditMonthChanged" Dense="true" Class="schedule-audit-select schedule-audit-select--month" Style="max-width: 150px;">
                <MudSelectItem Value="0">All</MudSelectItem>
                <MudSelectItem Value="1">January</MudSelectItem>
                <MudSelectItem Value="2">February</MudSelectItem>
                <MudSelectItem Value="3">March</MudSelectItem>
                <MudSelectItem Value="4">April</MudSelectItem>
                <MudSelectItem Value="5">May</MudSelectItem>
                <MudSelectItem Value="6">June</MudSelectItem>
                <MudSelectItem Value="7">July</MudSelectItem>
                <MudSelectItem Value="8">August</MudSelectItem>
                <MudSelectItem Value="9">September</MudSelectItem>
                <MudSelectItem Value="10">October</MudSelectItem>
                <MudSelectItem Value="11">November</MudSelectItem>
                <MudSelectItem Value="12">December</MudSelectItem>
            </MudSelect>
            <MudSelect T="string" Label="Filter Status" @bind-Value="_auditFilter" Dense="true" Style="max-width: 180px;" Class="schedule-audit-select schedule-audit-filter">
                <MudSelectItem Value="@("All")">Show All</MudSelectItem>
                <MudSelectItem Value="@("Missing")">Missing in DB</MudSelectItem>
                <MudSelectItem Value="@("Extra")">DB Only (Extra)</MudSelectItem>
                <MudSelectItem Value="@("Mismatch")">Mismatches</MudSelectItem>
            </MudSelect>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAuditData" Class="schedule-audit-refresh">
                Refresh Audit
            </MudButton>
        </MudStack>

        <MudAlert Severity="Severity.Info" Class="mb-4" Variant="Variant.Outlined">
            This tool compares local <b>Import/@(_auditMonth == 0 ? $"{_auditYear}-*.md" : $"{_auditYear}-{_auditMonth:D2}.md")</b> with the database. Missing or mismatched entries are highlighted.
        </MudAlert>

        @if (!string.IsNullOrEmpty(_missingFileWarning))
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => _missingFileWarning = null)">
                @_missingFileWarning
            </MudAlert>
        }

        <div class="d-block d-sm-none">
            @if (FilteredAuditRows.Any())
            {
                <MudStack Spacing="2">
                    @foreach (var row in FilteredAuditRows)
                    {
                        <MudPaper Elevation="0" Class="pa-4 mobile-feed-card mobile-audit-card" Style="@GetAuditRowStyle(row, 0)">
                            <MudStack Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@row.Date.ToString("MMMM dd, yyyy")</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Employee @row.Initials</MudText>
                                    </MudStack>

                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Variant="@GetAuditStatusVariant(row)"
                                             Color="@GetAuditStatusColor(row)">
                                        @GetAuditStatusText(row)
                                    </MudChip>
                                </MudStack>

                                <MudPaper Elevation="0" Class="pa-3 mobile-feed-card__details mobile-audit-card__panel">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary text-uppercase">Markdown entry</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@(row.MarkdownTime?.ToString("h:mm tt") ?? "No time")</MudText>
                                    <MudText Typo="Typo.body2" Class="@(row.InMarkdown ? string.Empty : "mud-text-secondary italic")">
                                        @(row.MarkdownDetails ?? "Not in file")
                                    </MudText>
                                </MudPaper>

                                <MudPaper Elevation="0" Class="pa-3 mobile-feed-card__details mobile-audit-card__panel">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary text-uppercase">Database entry</MudText>
                                    @if (row.DbLog != null)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@(row.DbLog.LogTime?.ToString("h:mm tt") ?? "No time")</MudText>
                                        <MudText Typo="Typo.body2"><b>@row.DbLog.SubCategory:</b> @row.DbLog.Details</MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary italic">No DB record</MudText>
                                    }
                                </MudPaper>

                                <MudStack Row="true" Justify="Justify.FlexEnd">
                                    @if (row.DbLog != null)
                                    {
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenEditDialog(row.DbLog))">
                                            Edit entry
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddMissingFromMarkdown(row))">
                                            Add missing entry
                                        </MudButton>
                                    }
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No audit rows match the current filters.</MudAlert>
            }
        </div>

        <div class="d-none d-sm-block schedule-table-shell">
            <MudTable Items="@FilteredAuditRows" Dense="true" Hover="true" FixedHeader="true" Height="600px" RowStyleFunc="GetAuditRowStyle">
                <HeaderContent>
                    <MudTh>Date</MudTh>
                    <MudTh>Emp</MudTh>
                    <MudTh>Markdown Entry (File)</MudTh>
                    <MudTh>Database Entry</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="width: 80px;">Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Date.ToString("MM/dd/yy")</MudTd>
                    <MudTd>@context.Initials</MudTd>
                    <MudTd>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @(context.MarkdownTime?.ToString("HH:mm") ?? "--:--")
                            </MudText>
                            <MudText Typo="Typo.body2" Class="@(context.InMarkdown ? string.Empty : "mud-text-secondary italic")">
                                @(context.MarkdownDetails ?? "Not in file")
                            </MudText>
                        </MudStack>
                    </MudTd>
                    <MudTd>
                        @if (context.DbLog != null)
                        {
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @(context.DbLog.LogTime?.ToString("HH:mm") ?? "--:--")
                                </MudText>
                                <MudText Typo="Typo.body2">
                                    <b>@context.DbLog.SubCategory:</b> @context.DbLog.Details
                                </MudText>
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary italic">No DB Record</MudText>
                        }
                    </MudTd>
                    <MudTd>
                        @if (!context.InMarkdown)
                        {
                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text">DB Only</MudChip>
                        }
                        else if (context.DbLog == null)
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">Missing</MudChip>
                        }
                        else if (Normalize(context.MarkdownDetails) != Normalize(context.DbLog.OriginalDetails))
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">Mismatch</MudChip>
                        }
                        else if (context.MarkdownTime != context.DbLog.LogTime)
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">Time Diff</MudChip>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                        }
                    </MudTd>
                    <MudTd>
                        @if (context.DbLog != null)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditDialog(context.DbLog))" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary" OnClick="@(() => AddMissingFromMarkdown(context))" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    </MudTabPanel>
</MudTabs>

