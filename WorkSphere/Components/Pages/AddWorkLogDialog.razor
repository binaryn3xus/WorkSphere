@using WorkSphere.Models
@using WorkSphere.Services
@using MudBlazor
@inject WorkLogService WorkLogService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@_title</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="4">
            @* Quick Action Shortcuts *@
            <MudText Typo="Typo.caption" Class="mb-n2">Quick Actions</MudText>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Business" OnClick="@(() => SetQuickAction("Work", "In-Office"))">Office</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Home" OnClick="@(() => SetQuickAction("Work", "Work From Home"))">WFH</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.ErrorOutline" OnClick="@(() => SetQuickAction("Work", "Incident Response", earnsComp: true))">GET Comp</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.AlarmOff" OnClick="@(() => SetQuickAction("Leave", "Comp Day", usesComp: true))">USE Comp</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.BeachAccess" OnClick="@(() => SetQuickAction("Leave", "PTO"))">PTO</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.LocalHospital" OnClick="@(() => SetQuickAction("Leave", "Sick Day"))">Sick</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.FamilyRestroom" OnClick="@(() => SetQuickAction("Leave", "FMLA Day"))">FMLA</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Celebration" OnClick="@(() => SetQuickAction("Leave", "Holiday"))">Holiday</MudButton>
            </MudStack>

            <MudDivider Class="my-2" />

            <MudGrid>
                <MudItem xs="6">
                    <MudDatePicker Label="Date" @bind-Date="DateProxy" PickerVariant="PickerVariant.Dialog" />
                </MudItem>
                <MudItem xs="6">
                    <MudTimePicker Label="Time" @bind-Time="TimeProxy" PickerVariant="PickerVariant.Dialog" MinuteSelectionStep="5" />
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="int" Label="Employee" @bind-Value="_log.EmployeeId">
                        @foreach (var emp in _employees)
                        {
                            <MudSelectItem Value="@emp.Id">@emp.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6">
                    <MudSelect T="string" Label="Main Category" Value="_log.MainCategory" ValueChanged="OnMainCategoryChanged">
                        @foreach (var main in _categoryMap.Keys)
                        {
                            <MudSelectItem Value="@main" />
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6">
                    <MudSelect T="string" Label="Sub-Category" @bind-Value="_log.SubCategory">
                        @foreach (var sub in _currentSubCategories)
                        {
                            <MudSelectItem Value="@sub" />
                        }
                    </MudSelect>
                </MudItem>
                
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-4 mud-background-gray border-all" Style="border: 1px dashed var(--mud-palette-divider);">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2">Comp Time Settings</MudText>
                            <MudStack Row="true">
                                <MudCheckBox T="bool" @bind-Value="_log.EarnsCompTime" Label="Earns Comp Time" Color="Color.Warning" />
                                <MudCheckBox T="bool" @bind-Value="_log.UsesCompTime" Label="Uses Comp Time" Color="Color.Error" />
                            </MudStack>
                            
                            @if (_log.EarnsCompTime || _log.UsesCompTime)
                            {
                                <MudNumericField Label="@(_log.EarnsCompTime ? "Hours Earned" : "Hours Used")" @bind-Value="_log.Hours" Min="0" Step="0.25m" Variant="Variant.Outlined" />
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12">
                    <MudCheckBox T="bool" Value="_linkToIncident" ValueChanged="OnLinkToIncidentChanged" Label="Link to Incident" Color="Color.Primary" />
                </MudItem>

                @if (_linkToIncident)
                {
                    <MudItem xs="12">
                        <MudSelect T="int?" Label="Select Incident" @bind-Value="_log.IncidentId" Clearable="true">
                            @foreach (var inc in _incidents)
                            {
                                <MudSelectItem Value="@((int?)inc.Id)">@inc.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                <MudItem xs="12">
                    @* Details with Hot Buttons *@
                    <div>
                        <MudTextField Label="Details" @bind-Value="_log.Details" Lines="2" />
                        <MudStack Row="true" Spacing="1" Class="mt-1">
                            <MudChip T="string" Size="Size.Small" OnClick="@(() => AddDetail("Unexpected"))" Variant="Variant.Text">+Unexpected</MudChip>
                            <MudChip T="string" Size="Size.Small" OnClick="@(() => AddDetail("Swap"))" Variant="Variant.Text">+Swap</MudChip>
                        </MudStack>
                    </div>
                </MudItem>
            </MudGrid>
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (_log.Id != 0)
        {
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="DeleteLog" StartIcon="@Icons.Material.Filled.Delete" Class="mr-auto">Delete</MudButton>
        }
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save Entry</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudBlazor.IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public WorkLog Log { get; set; } = new() 
    { 
        LogDate = DateOnly.FromDateTime(DateTime.Today),
        LogTime = new TimeOnly(DateTime.Now.Hour, DateTime.Now.Minute),
        MainCategory = "Work",
        SubCategory = "In-Office"
    };

    private string _title => Log.Id == 0 ? "Add Log" : "Edit Log";
    private WorkLog _log = new();
    private IEnumerable<Employee> _employees = new List<Employee>();
    private IEnumerable<Incident> _incidents = new List<Incident>();
    private bool _linkToIncident;

    private Dictionary<string, List<string>> _categoryMap = new()
    {
        { "Work", new List<string> { "In-Office", "Work From Home", "Remote Location", "Incident Response" } },
        { "Leave", new List<string> { "PTO", "Sick Day", "FMLA Day", "Comp Day", "Holiday" } },
        { "Other", new List<string> { "Other" } }
    };

    private List<string> _currentSubCategories => _categoryMap.ContainsKey(_log.MainCategory) 
        ? _categoryMap[_log.MainCategory] 
        : new List<string> { "Other" };

    protected override async Task OnInitializedAsync()
    {
        _employees = await WorkLogService.GetEmployeesAsync();
        _incidents = await WorkLogService.GetIncidentsAsync();
        
        _log = new WorkLog
        {
            Id = Log.Id,
            LogDate = Log.LogDate,
            LogTime = Log.LogTime,
            EmployeeId = Log.EmployeeId == 0 ? _employees.FirstOrDefault()?.Id ?? 0 : Log.EmployeeId,
            MainCategory = Log.MainCategory,
            SubCategory = Log.SubCategory,
            Details = Log.Details,
            OriginalDetails = Log.OriginalDetails,
            IncidentId = Log.IncidentId,
            EarnsCompTime = Log.EarnsCompTime,
            UsesCompTime = Log.UsesCompTime,
            Hours = Log.Hours
        };

        _linkToIncident = _log.IncidentId.HasValue;
    }

    private void OnLinkToIncidentChanged(bool val)
    {
        _linkToIncident = val;
        if (!val)
        {
            _log.IncidentId = null;
        }
    }

    private void SetQuickAction(string main, string sub, bool earnsComp = false, bool usesComp = false)
    {
        _log.MainCategory = main;
        _log.SubCategory = sub;
        _log.EarnsCompTime = earnsComp;
        _log.UsesCompTime = usesComp;
        
        if (earnsComp)
        {
            _linkToIncident = true;
        }
        
        Snackbar.Add($"Set to {sub}", Severity.Info);
    }

    private void AddDetail(string text)
    {
        if (string.IsNullOrWhiteSpace(_log.Details))
            _log.Details = text;
        else if (!_log.Details.Contains(text))
            _log.Details += $" ({text})";
    }

    private void OnMainCategoryChanged(string val)
    {
        _log.MainCategory = val;
        _log.SubCategory = _categoryMap[val].First();
    }

    private DateTime? DateProxy
    {
        get => _log.LogDate?.ToDateTime(TimeOnly.MinValue);
        set => _log.LogDate = value.HasValue ? DateOnly.FromDateTime(value.Value) : null;
    }

    private TimeSpan? TimeProxy
    {
        get => _log.LogTime?.ToTimeSpan();
        set => _log.LogTime = value.HasValue ? TimeOnly.FromTimeSpan(value.Value) : null;
    }

    private void Submit() 
    {
        MudDialog.Close(DialogResult.Ok(_log));
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task DeleteLog()
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete", 
            "Are you sure you want to delete this work log?", 
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            await WorkLogService.DeleteWorkLogAsync(_log.Id);
            Snackbar.Add("Work log deleted", Severity.Success);
            MudDialog.Close(DialogResult.Cancel());
        }
    }
}
