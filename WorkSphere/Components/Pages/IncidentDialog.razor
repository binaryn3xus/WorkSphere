@using WorkSphere.Models
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(Incident.Id == 0 ? "New Incident" : "Edit Incident")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="4">
            <MudTextField Label="Ticket Number" @bind-Value="Incident.TicketNumber" Placeholder="e.g., INC-123456" />
            <MudTextField Label="Title" @bind-Value="Incident.Title" Required="true" RequiredError="Title is required" />
            <MudTextField Label="Description" @bind-Value="Incident.Description" Lines="3" />
            
            <MudGrid>
                <MudItem xs="6">
                    <MudDatePicker Label="Start Date" @bind-Date="StartDateProxy" />
                </MudItem>
                <MudItem xs="6">
                    <MudTimePicker Label="Start Time" @bind-Time="StartTimeProxy" />
                </MudItem>
                <MudItem xs="6">
                    <MudDatePicker Label="End Date" @bind-Date="EndDateProxy" Clearable="true" />
                </MudItem>
                <MudItem xs="6">
                    <MudTimePicker Label="End Time" @bind-Time="EndTimeProxy" Clearable="true" />
                </MudItem>
            </MudGrid>

            <MudCheckBox @bind-Value="Incident.IsClosed" Label="Closed" Color="Color.Success" T="bool" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudBlazor.IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Incident Incident { get; set; } = new();

    private DateTime? StartDateProxy
    {
        get => Incident.StartedAt.Date;
        set => Incident.StartedAt = (value ?? Incident.StartedAt.Date).Add(Incident.StartedAt.TimeOfDay);
    }

    private TimeSpan? StartTimeProxy
    {
        get => Incident.StartedAt.TimeOfDay;
        set => Incident.StartedAt = Incident.StartedAt.Date.Add(value ?? TimeSpan.Zero);
    }

    private DateTime? EndDateProxy
    {
        get => Incident.EndedAt?.Date;
        set 
        {
            if (value == null) Incident.EndedAt = null;
            else Incident.EndedAt = value.Value.Date.Add(Incident.EndedAt?.TimeOfDay ?? TimeSpan.Zero);
        }
    }

    private TimeSpan? EndTimeProxy
    {
        get => Incident.EndedAt?.TimeOfDay;
        set
        {
            if (value == null) Incident.EndedAt = null;
            else Incident.EndedAt = (Incident.EndedAt?.Date ?? DateTime.Today).Add(value.Value);
        }
    }

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(Incident.Title)) return;
        MudDialog.Close(DialogResult.Ok(Incident));
    }
    
    private void Cancel() => MudDialog.Cancel();
}
